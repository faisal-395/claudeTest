@inherits LayoutComponentBase
@inject AuthState AuthState
@inject NavigationManager Nav
@inject ApiClient Api
@inject IJSRuntime JS
@implements IDisposable

@if (!AuthState.IsAuthenticated)
{
    @Body
}
else if (_navigationLayout == NavigationLayout.TopMenu)
{
    <div class="app-shell-top">
        <header class="topbar">
            <div class="topbar-brand">
                Umer Farooq &amp; Brothers
                <small>@AuthState.FullName (@AuthState.RoleName)</small>
            </div>
            <nav class="topbar-nav">
                @{
                    var topNavGroups = NavGroups;
                    var lastDropdownIndex = topNavGroups.FindLastIndex(g => g.Label is not null);
                }
                @for (var i = 0; i < topNavGroups.Count; i++)
                {
                    var group = topNavGroups[i];
                    var isLastDropdown = i == lastDropdownIndex;
                    @if (group.Label is null)
                    {
                        @foreach (var item in group.Items)
                        {
                            <NavLink class="topbar-link" href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@item.Text">@Icon(item.IconName)<span>@item.Text</span></NavLink>
                        }
                    }
                    else
                    {
                        var label = group.Label;
                        <div class="topbar-dropdown @(_closingDropdownLabel == label ? "closing" : "")" @onmouseleave="() => ClearClosing(label)">
                            <button type="button" class="topbar-dropdown-trigger">@label @Icon("chevron-down")</button>
                            <div class="topbar-dropdown-menu @(isLastDropdown ? "align-right" : "")">
                                @foreach (var item in group.Items)
                                {
                                    <NavLink href="@item.Href" title="@item.Text" @onclick="() => CloseDropdown(label)">@Icon(item.IconName)<span>@item.Text</span></NavLink>
                                }
                            </div>
                        </div>
                    }
                }
                <a href="#" @onclick="Logout" @onclick:preventDefault="true" class="topbar-link topbar-logout" title="Quit / Logout">@Icon("logout")<span>Logout</span></a>
            </nav>
        </header>
        <div class="main-content">
            @Body
        </div>
    </div>
}
else
{
    <div class="app-shell">
        <div class="sidebar @(_iconOnly ? "collapsed" : "")">
            <div class="brand">
                <span class="brand-full">
                    Umer Farooq &amp; Brothers<br />
                    <small>@AuthState.FullName (@AuthState.RoleName)</small>
                </span>
            </div>
            <button class="sidebar-toggle" @onclick="ToggleSidebar" title="@(_iconOnly ? "Expand menu" : "Collapse menu")">
                @Icon(_iconOnly ? "chevron-right" : "chevron-left")
                <span class="nav-text">@(_iconOnly ? "Expand" : "Collapse")</span>
            </button>
            <nav>
                @foreach (var group in NavGroups)
                {
                    @if (group.Label is null)
                    {
                        @foreach (var item in group.Items)
                        {
                            <NavLink href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@item.Text">@Icon(item.IconName)<span class="nav-text">@item.Text</span></NavLink>
                        }
                    }
                    else
                    {
                        <div class="brand nav-section-label"><span class="brand-full">@group.Label</span></div>
                        <ul class="nav-group">
                            @foreach (var item in group.Items)
                            {
                                <li><NavLink href="@item.Href" title="@item.Text">@Icon(item.IconName)<span class="nav-text">@item.Text</span></NavLink></li>
                            }
                        </ul>
                    }
                }

                <a href="#" @onclick="Logout" @onclick:preventDefault="true" class="nav-logout" title="Quit / Logout">@Icon("logout")<span class="nav-text">Quit / Logout</span></a>
            </nav>
        </div>
        <div class="main-content">
            @Body
        </div>
    </div>
}

@code {
    // Kachi and Pakki's batch-entry grids, and the combined Records Report grid, are wide — squeeze
    // the sidebar down to an icon-only rail on those pages so the grid has more room, and restore
    // full width everywhere else.
    private static readonly string[] IconOnlyRoutes = { "kachi", "pakki", "records-report" };

    private bool _iconOnly;
    private NavigationLayout _navigationLayout = NavigationLayout.TopMenu;

    // Top-menu dropdowns open on :hover (plain CSS, see .topbar-dropdown:hover in app.css) — but a
    // hover-driven dropdown has no way to close itself after clicking a link inside it, since
    // Blazor navigation doesn't reload the page and the mouse is still sitting over the same spot
    // afterward. CloseDropdown forces that one dropdown shut via the .closing class (display:none
    // !important, overriding the :hover rule) the instant its link is clicked; ClearClosing lifts
    // the override once the mouse actually leaves, so hovering the same dropdown again later still
    // opens it normally. Deliberately not cleared from OnLocationChanged — the mouse is still
    // hovering right after a click, so clearing the override there would let :hover reopen it
    // immediately.
    private string? _closingDropdownLabel;

    private void CloseDropdown(string label) => _closingDropdownLabel = label;

    private void ClearClosing(string label)
    {
        if (_closingDropdownLabel == label) _closingDropdownLabel = null;
    }

    private record NavItem(string Href, string IconName, string Text);

    /// <summary>The same grouped menu structure drives both the sidebar and the top-menu layout —
    /// a group with a null Label renders as a single top-level link (just Dashboard today); every
    /// other group renders as a labeled section (sidebar) or a dropdown (top menu). A labeled group
    /// is only included once it actually has at least one permitted item, so a role with no Setup
    /// access, say, doesn't get an empty "Setup" section/dropdown.</summary>
    private List<(string? Label, List<NavItem> Items)> NavGroups
    {
        get
        {
            var groups = new List<(string? Label, List<NavItem> Items)>
            {
                (null, new List<NavItem> { new("", "dashboard", "Dashboard") })
            };

            void AddGroup(string label, params (bool Visible, NavItem Item)[] candidates)
            {
                var items = candidates.Where(c => c.Visible).Select(c => c.Item).ToList();
                if (items.Count > 0) groups.Add((label, items));
            }

            AddGroup("Receipts",
                (AuthState.CanView(ModuleName.Kachi), new NavItem("kachi", "kachi", "Kachi")),
                (AuthState.CanView(ModuleName.Pakki), new NavItem("pakki", "pakki", "Pakki")));

            // Trading (ModuleName.Trading) is intentionally omitted — re-enable by adding
            // (AuthState.CanView(ModuleName.Trading), new NavItem("trading", "trading", "Trading"))
            // to a group (its own, or folded into one of the ones below).
            AddGroup("Purchase & Sale",
                (AuthState.CanView(ModuleName.SaleInvoice), new NavItem("sale-invoice", "sale-invoice", "Sale Invoice")),
                (AuthState.CanView(ModuleName.Purchase), new NavItem("purchase", "purchase", "Purchase")),
                (AuthState.CanView(ModuleName.SetupProducts), new NavItem("stock", "stock", "Stock")),
                (AuthState.CanView(ModuleName.Reports), new NavItem("records-report", "chart-of-accounts", "Records Report")));

            AddGroup("Vouchers",
                (AuthState.CanView(ModuleName.Payment), new NavItem("payment", "payment", "Payment")),
                (AuthState.CanView(ModuleName.Receipt), new NavItem("receipt", "receipt", "Receipt")),
                (AuthState.CanView(ModuleName.Journal), new NavItem("journal", "journal", "Journal")),
                (AuthState.CanView(ModuleName.Expense), new NavItem("expense", "expense", "Expense")),
                (AuthState.CanView(ModuleName.Payment), new NavItem("vouchers", "chart-of-accounts", "Voucher Records")));

            // Recovery (ModuleName.Recovery) is intentionally omitted — re-enable by adding
            // (AuthState.CanView(ModuleName.Recovery), new NavItem("recovery", "recovery", "Recovery"))
            // below.
            AddGroup("Accounts",
                (AuthState.CanView(ModuleName.Ledger), new NavItem("ledger", "ledger", "Ledger")),
                (AuthState.CanView(ModuleName.Ledger), new NavItem("reports/party-account", "user", "Party Account Statement")),
                (AuthState.CanView(ModuleName.Reports), new NavItem("reports/position", "chart-of-accounts", "Position in Hand")),
                (AuthState.CanView(ModuleName.Approvals), new NavItem("approvals", "ledger", "Pending Approvals")));

            AddGroup("Setup",
                (AuthState.CanView(ModuleName.SetupParty), new NavItem("setup/parties", "party", "Party")),
                (AuthState.CanView(ModuleName.SetupProducts), new NavItem("setup/products", "products", "Products")),
                (AuthState.CanView(ModuleName.SetupProducts), new NavItem("setup/product-types", "products", "Product Types")),
                (AuthState.CanView(ModuleName.SetupProducts), new NavItem("setup/product-units", "products", "Units")),
                (AuthState.CanView(ModuleName.SetupChartOfAccounts), new NavItem("setup/chart-of-accounts", "chart-of-accounts", "Chart of Accounts")),
                (AuthState.CanView(ModuleName.SetupChartOfAccounts), new NavItem("setup/account-types", "chart-of-accounts", "Account Types")),
                (AuthState.CanView(ModuleName.SetupDeductionRules), new NavItem("setup/deduction-rules", "format", "Format (Deductions)")),
                (AuthState.CanView(ModuleName.SetupUnitConversions), new NavItem("setup/unit-conversions", "unit-conversions", "Unit Conversions")),
                (AuthState.CanView(ModuleName.SetupSeasons), new NavItem("setup/seasons", "seasons", "Seasons")),
                (AuthState.CanView(ModuleName.SetupCompanyInfo), new NavItem("setup/company-info", "party", "Company Info")),
                (AuthState.CanView(ModuleName.SetupAppearance), new NavItem("setup/appearance", "appearance", "Appearance")),
                (AuthState.CanView(ModuleName.SetupUsersRoles), new NavItem("setup/users", "user-account", "User Account")),
                (AuthState.CanView(ModuleName.SetupUsersRoles), new NavItem("setup/roles", "user-account", "Roles")),
                (AuthState.CanView(ModuleName.Backup), new NavItem("backup", "backup", "Backup")));

            return groups;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        UpdateIconOnly(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
        AuthState.Changed += OnAuthChanged;

        // Covers a session restored from a persisted token (already authenticated by the time this
        // component first initializes). A login that happens later is caught by OnAuthChanged
        // instead, since this layout — and therefore this method — only ever runs once per app
        // session, before the user necessarily has a token.
        if (AuthState.IsAuthenticated)
        {
            await ApplyThemeAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateIconOnly(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void OnAuthChanged()
    {
        if (AuthState.IsAuthenticated)
        {
            _ = InvokeAsync(ApplyThemeAsync);
        }
    }

    /// <summary>Fetches every ThemeScope's saved brand colors and applies them as scoped CSS custom
    /// property overrides (see index.html's applyTheme), so the whole app — and each of Sale
    /// Invoice/Purchase/Kachi/Pakki's own colors — re-skins immediately without a reload. Also picks
    /// up Global's NavigationLayout, the one app-wide sidebar-vs-top-menu choice. Best-effort: a
    /// failure here just leaves app.css's default colors/the sidebar layout in place rather than
    /// blocking login or any page.</summary>
    private async Task ApplyThemeAsync()
    {
        try
        {
            var scopedSettings = await Api.GetAppearanceSettingsAsync();
            var global = scopedSettings.FirstOrDefault(s => s.Scope == ThemeScope.Global);
            if (global is not null)
            {
                _navigationLayout = global.NavigationLayout;
            }
            await JS.InvokeVoidAsync("applyTheme", scopedSettings);
            StateHasChanged();
        }
        catch
        {
        }
    }

    private void UpdateIconOnly(string uri)
    {
        var relativePath = Nav.ToBaseRelativePath(uri).Split('?', '#')[0].TrimEnd('/');
        _iconOnly = IconOnlyRoutes.Contains(relativePath, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Manual override for the auto (route-based) icon-only squeeze — lets the operator
    /// collapse or expand the sidebar on any page. The next navigation recomputes it from the
    /// route again via UpdateIconOnly.</summary>
    private void ToggleSidebar() => _iconOnly = !_iconOnly;

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        AuthState.Changed -= OnAuthChanged;
    }

    private void Logout()
    {
        AuthState.Clear();
        AuthState.ClearPersistedToken();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    private static MarkupString Icon(string name)
    {
        var inner = name switch
        {
            "chevron-left" => "<polyline points='15,18 9,12 15,6'/>",
            "chevron-right" => "<polyline points='9,18 15,12 9,6'/>",
            "chevron-down" => "<polyline points='6,9 12,15 18,9'/>",
            "dashboard" => "<polyline points='4,12 12,5 20,12'/><rect x='6' y='12' width='12' height='8'/>",
            "kachi" => "<rect x='5' y='3' width='14' height='18' rx='1'/><line x1='8' y1='9' x2='16' y2='9'/><line x1='8' y1='13' x2='16' y2='13'/><line x1='8' y1='17' x2='13' y2='17'/>",
            "pakki" => "<rect x='5' y='3' width='14' height='18' rx='1'/><polyline points='9,12 11,14 15,9'/>",
            "records" => "<line x1='4' y1='7' x2='20' y2='7'/><line x1='4' y1='12' x2='20' y2='12'/><line x1='4' y1='17' x2='20' y2='17'/>",
            "trading" => "<line x1='4' y1='20' x2='4' y2='12'/><line x1='10' y1='20' x2='10' y2='6'/><line x1='16' y1='20' x2='16' y2='14'/><line x1='20' y1='20' x2='20' y2='4'/>",
            "sale-invoice" => "<rect x='5' y='3' width='14' height='18' rx='1'/><line x1='12' y1='8' x2='12' y2='16'/><line x1='9' y1='10.5' x2='15' y2='10.5'/><line x1='9' y1='13.5' x2='14' y2='13.5'/>",
            "purchase" => "<circle cx='9' cy='20' r='1.4'/><circle cx='17' cy='20' r='1.4'/><polyline points='3,4 6,4 8,15 18,15 20,7 7,7'/>",
            "stock" => "<path d='M3 7l9-4 9 4-9 4-9-4z'/><path d='M3 7v10l9 4 9-4V7'/><line x1='12' y1='11' x2='12' y2='21'/>",
            "payment" => "<rect x='3' y='6' width='18' height='12' rx='1.5'/><line x1='3' y1='10' x2='21' y2='10'/>",
            "receipt" => "<polyline points='6,3 6,21 9,19 12,21 15,19 18,21 18,3 15,5 12,3 9,5'/><line x1='9' y1='9' x2='15' y2='9'/><line x1='9' y1='13' x2='15' y2='13'/>",
            "journal" => "<rect x='3' y='5' width='8' height='14' rx='1'/><rect x='13' y='5' width='8' height='14' rx='1'/>",
            "expense" => "<circle cx='12' cy='12' r='9'/><line x1='8' y1='12' x2='16' y2='12'/>",
            "ledger" => "<rect x='3' y='4' width='18' height='16' rx='1'/><line x1='3' y1='10' x2='21' y2='10'/><line x1='9' y1='10' x2='9' y2='20'/><line x1='15' y1='10' x2='15' y2='20'/>",
            "user" => "<path d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/>",
            "recovery" => "<path d='M21 12a9 9 0 1 1-3-6.7'/><polyline points='21 3 21 9 15 9'/>",
            "party" => "<path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'/><circle cx='9' cy='7' r='4'/><path d='M23 21v-2a4 4 0 0 0-3-3.87'/><path d='M16 3.13a4 4 0 0 1 0 7.75'/>",
            "products" => "<path d='M21 8l-9-5-9 5 9 5 9-5z'/><path d='M3 8v8l9 5 9-5V8'/><line x1='12' y1='13' x2='12' y2='21'/>",
            "chart-of-accounts" => "<rect x='3' y='3' width='7' height='7'/><rect x='14' y='3' width='7' height='7'/><rect x='3' y='14' width='7' height='7'/><rect x='14' y='14' width='7' height='7'/>",
            "format" => "<line x1='4' y1='21' x2='4' y2='14'/><line x1='4' y1='10' x2='4' y2='3'/><line x1='12' y1='21' x2='12' y2='12'/><line x1='12' y1='8' x2='12' y2='3'/><line x1='20' y1='21' x2='20' y2='16'/><line x1='20' y1='12' x2='20' y2='3'/><line x1='1' y1='14' x2='7' y2='14'/><line x1='9' y1='8' x2='15' y2='8'/><line x1='17' y1='16' x2='23' y2='16'/>",
