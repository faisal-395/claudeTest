@page "/multi-purchase"
@using GrainMarket.Application.Common.Exceptions
@using GrainMarket.Application.Common.Services
@using GrainMarket.Application.MultiPurchase
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <h1 class="page-title">Multi-Farmer Purchase <span class="rtl-urdu" style="font-size:1rem;">ایک خریدار، کئی کسان</span></h1>
    <p style="color:#777;">One buyer purchasing several items from several farmers in one sitting — each row still
        posts as its own Kachi + Pakki (every farmer is still paid individually against their own weight and
        deductions), raised together and printed as one consolidated receipt. Paledari, brokerage/commission,
        association fund (anjuman) and withholding tax below update live as you fill in each row.</p>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    <div class="form-grid" style="max-width:1100px;margin-bottom:16px;">
        <div><label>Date / تاریخ</label><input type="date" @bind="_date" /></div>
        <div>
            <label>Season / سیزن</label>
            <select @bind="_seasonId">
                @if (_seasons is not null) { @foreach (var s in _seasons) { <option value="@s.Id">@s.Name</option> } }
            </select>
        </div>
        <div style="grid-column: span 2;">
            <label>Buyer / خریدار</label>
            <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
        </div>
    </div>

    <div style="overflow-x:auto;">
        <table class="data-grid" style="min-width:1300px;">
            <thead>
                <tr>
                    <th style="min-width:170px;">Farmer / کسان</th>
                    <th style="min-width:150px;">Product / جنس</th>
                    <th>Man</th><th>Kilo</th><th>Gram</th><th>Bori</th>
                    <th>Rate/Man</th><th>Net Wt (kg)</th><th>Gross</th><th>Deductions</th><th>Net Payable</th><th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _rows.Count; i++)
                {
                    var index = i;
                    var row = _rows[index];
                    var calc = Calculate(row);
                    <tr>
                        <td><SearchSelect TItem="PartyDto" Items="_farmers" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" Value="@row.FarmerId" ValueChanged="@(v => row.FarmerId = v)" Placeholder="Farmer…" /></td>
                        <td><SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" Value="@row.ProductId" ValueChanged="@(v => row.ProductId = v)" Placeholder="Product…" /></td>
                        <td><input type="number" step="0.01" style="width:75px;" @bind="row.ManQty" /></td>
                        <td><input type="number" step="0.01" style="width:75px;" @bind="row.KiloQty" /></td>
                        <td><input type="number" step="1" style="width:65px;" @bind="row.GramQty" /></td>
                        <td><input type="number" step="0.01" style="width:65px;" @bind="row.BoriQty" /></td>
                        <td><input type="number" step="0.01" style="width:85px;" @bind="row.RatePerUnit" /></td>
                        <td class="ltr-inline">@(calc is not null ? calc.NetWeightKg.ToString("N2") : "—")</td>
                        <td class="ltr-inline">@(calc is not null ? calc.GrossAmount.ToString("N2") : "—")</td>
                        <td class="ltr-inline">@(calc is not null ? calc.Deductions.TotalDeductions.ToString("N2") : "—")</td>
                        <td class="ltr-inline"><b>@(calc is not null ? calc.NetPayable.ToString("N2") : "—")</b></td>
                        <td><button class="btn danger" @onclick="() => RemoveRow(index)">Remove</button></td>
                    </tr>
                    @if (calc is not null && calc.Deductions.Lines.Count > 0)
                    {
                        <tr>
                            <td colspan="12" style="background:#f7f9f7;padding:4px 10px;font-size:0.85rem;color:#444;">
                                @string.Join("   ·   ", calc.Deductions.Lines.Select(l => $"{l.Name}: {l.Amount:N2}"))
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <button class="btn secondary" style="margin-top:8px;" @onclick="AddRow">+ Add Row</button>

    <div class="form-grid" style="max-width:700px;margin-top:16px;">
        <div class="total-figure">Grand Gross: Rs @GrandGross.ToString("N2")</div>
        <div class="total-figure">Grand Deductions: Rs @GrandDeductions.ToString("N2")</div>
        <div class="total-figure">Grand Net Payable: Rs @GrandNet.ToString("N2")</div>
        <div style="grid-column: span 2;">
            @if (!CanSave)
            {
                <div class="invalid-total">Pick a buyer, and give every row a farmer, product, weight and a rate greater than zero.</div>
            }
            <button class="btn" disabled="@(!CanSave || _saving)" @onclick="SaveAsync">@(_saving ? "Saving…" : "Save & Print Consolidated Receipt")</button>
        </div>
    </div>
</RequireAuth>

@code {
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private List<DeductionRule>? _deductionRuleEntities;
    private List<UnitConversion>? _unitConversionEntities;
    private string? _error;
    private bool _saving;

    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _buyerId;
    private readonly List<RowModel> _rows = new();

    private decimal GrandGross => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.GrossAmount);
    private decimal GrandDeductions => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.Deductions.TotalDeductions);
    private decimal GrandNet => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.NetPayable);

    private bool CanSave =>
        _buyerId > 0 && _rows.Count > 0 &&
        _rows.All(r => r.FarmerId > 0 && r.ProductId > 0 && r.RatePerUnit > 0 &&
                        (r.ManQty ?? 0) + (r.KiloQty ?? 0) + (r.GramQty ?? 0) + (r.BoriQty ?? 0) > 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Buyer);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_buyers.Count > 0) _buyerId = _buyers[0].Id;

            var rules = await Api.GetDeductionRulesAsync();
            _deductionRuleEntities = rules.Select(r => new DeductionRule
            {
                Id = r.Id, Name = r.Name, NameUrdu = r.NameUrdu, CalculationType = r.CalculationType, Value = r.Value,
                AppliesTo = r.AppliesTo, SortOrder = r.SortOrder, IsActive = r.IsActive,
                ProductId = r.ProductId, PartyId = r.PartyId, RequiresVehicleNumber = r.RequiresVehicleNumber,
                IncomeAccountId = r.IncomeAccountId
            }).ToList();

            var conversions = await Api.GetUnitConversionsAsync();
            _unitConversionEntities = conversions.Select(c => new UnitConversion
            {
                Id = c.Id, Unit = c.Unit, FactorToKg = c.FactorToKg, ProductId = c.ProductId, IsActive = c.IsActive
            }).ToList();

            AddRow();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void AddRow() => _rows.Add(new RowModel
    {
        FarmerId = _farmers?.FirstOrDefault()?.Id ?? 0,
        ProductId = _products?.FirstOrDefault()?.Id ?? 0
    });

    private void RemoveRow(int index) => _rows.RemoveAt(index);

    /// <summary>Live per-row preview — reuses the exact same DeductionEngine/UnitConversionCalculator
    /// the server uses to post the Pakki, so this always matches what actually gets charged; not a
    /// second, hand-written copy of the math that could drift from it. Returns null while the row
    /// is still incomplete (no weight yet, no rate yet, no conversion factor configured, ...).</summary>
    private RowCalculation? Calculate(RowModel row)
    {
        if (_deductionRuleEntities is null || _unitConversionEntities is null || row.RatePerUnit <= 0) return null;

        try
        {
            var netWeightKg = UnitConversionCalculator.ToBaseKg(row.ManQty, row.KiloQty, row.GramQty, row.BoriQty, row.ProductId, _unitConversionEntities);
            var gross = UnitConversionCalculator.GrossAmountFromRatePerMan(row.RatePerUnit, netWeightKg, row.ProductId, _unitConversionEntities);
            var deductions = DeductionEngine.Calculate(gross, netWeightKg, DeductionAppliesTo.Pakki, row.ProductId, row.FarmerId, _deductionRuleEntities);
            return new RowCalculation(netWeightKg, gross, deductions, deductions.NetAmount);
        }
        catch (InvalidCalculationException)
        {
            return null;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saving = true;
        try
        {
            var request = new CreateMultiPurchaseRequest(_date, _seasonId, _buyerId,
                _rows.Select(r => new MultiPurchaseRowRequest(r.FarmerId, r.ProductId, r.ManQty, r.KiloQty, r.GramQty, r.BoriQty, r.RatePerUnit, r.VehicleNumber, r.Notes)).ToList());

            var result = await Api.CreateMultiPurchaseAsync(request);
            var ids = string.Join(",", result.Rows.Select(r => r.PakkiId));
            Nav.NavigateTo($"/print/multi-purchase?ids={ids}");
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private class RowModel
    {
        public int FarmerId { get; set; }
        public int ProductId { get; set; }
        public decimal? ManQty { get; set; }
        public decimal? KiloQty { get; set; }
        public decimal? GramQty { get; set; }
        public decimal? BoriQty { get; set; }
        public decimal RatePerUnit { get; set; }
        public string? VehicleNumber { get; set; }
        public string? Notes { get; set; }
    }

    private record RowCalculation(decimal NetWeightKg, decimal GrossAmount, DeductionCalculationResult Deductions, decimal NetPayable);
}
