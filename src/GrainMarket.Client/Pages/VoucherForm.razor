@using GrainMarket.Application.Common
@inject ApiClient Api

<div style="display:grid;grid-template-columns:4fr 5fr;gap:20px;align-items:start;">
    <div>
        <h1 class="page-title">@Title</h1>

        @if (_error is not null)
        {
            <div class="error-banner">@_error</div>
        }
        @if (_successMessage is not null)
        {
            <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
        }

        <div class="form-grid">
            <div style="grid-column: span 2; display:flex; gap:16px; flex-wrap:wrap;">
                <div>
                    <label>Search Voucher #</label>
                    <input @bind="_searchVoucherNo" @bind:event="oninput" @onkeydown="OnSearchKeyDown" style="width:150px;" placeholder="# then Enter" />
                </div>
                <div>
                    <label>@Title #</label>
                    <div class="batch-readonly-figure" style="width:140px;">@(DisplayedVoucherNo ?? "…")</div>
                </div>
                <div>
                    <label>Date</label>
                    <input type="date" @bind="_date" @bind:after="LoadGridVouchersAsync" style="width:140px;" />
                </div>
            </div>

            <div style="grid-column: span 2; max-width:380px;">
                <label>From</label>
                <select @bind="_fromType" style="margin-bottom:6px;">
                    <option value="@LedgerPartyRefType.Cash">Cash</option>
                    <option value="@LedgerPartyRefType.Bank">Bank</option>
                    <option value="@LedgerPartyRefType.Party">Party</option>
                    <option value="@LedgerPartyRefType.Account">Account</option>
                </select>
                @if (_fromType is LedgerPartyRefType.Cash or LedgerPartyRefType.Bank)
                {
                    <div class="batch-readonly-figure">@(FixedAccountFor(_fromType)?.Name ?? "…")</div>
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(FixedAccountFor(_fromType)?.CurrentBalance.ToString("N2") ?? "0.00")</div>
                }
                else if (_fromType == LedgerPartyRefType.Party)
                {
                    <SearchSelect TItem="PartyDto" Items="_parties" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Party" Value="@(_fromPartyId ?? 0)" ValueChanged="@(v => _fromPartyId = v)" Placeholder="Search party…" />
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(SelectedFromPartyBalance?.ToString("N2") ?? "0.00")</div>
                }
                else
                {
                    <SearchSelect TItem="ChartOfAccountDto" Items="_accounts" IdSelector="@(a => a.Id)" TextSelector="@DisplayText.Account" Value="@(_fromAccountId ?? 0)" ValueChanged="@(v => _fromAccountId = v)" Placeholder="Search account…" />
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(SelectedFromAccountBalance?.ToString("N2") ?? "0.00")</div>
                }
            </div>

            <div style="grid-column: span 2; max-width:380px;">
                <label>To</label>
                <select @bind="_toType" style="margin-bottom:6px;">
                    <option value="@LedgerPartyRefType.Cash">Cash</option>
                    <option value="@LedgerPartyRefType.Bank">Bank</option>
                    <option value="@LedgerPartyRefType.Party">Party</option>
                    <option value="@LedgerPartyRefType.Account">Account</option>
                </select>
                @if (_toType is LedgerPartyRefType.Cash or LedgerPartyRefType.Bank)
                {
                    <div class="batch-readonly-figure">@(FixedAccountFor(_toType)?.Name ?? "…")</div>
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(FixedAccountFor(_toType)?.CurrentBalance.ToString("N2") ?? "0.00")</div>
                }
                else if (_toType == LedgerPartyRefType.Party)
                {
                    <SearchSelect TItem="PartyDto" Items="_parties" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Party" Value="@(_toPartyId ?? 0)" ValueChanged="@(v => _toPartyId = v)" Placeholder="Search party…" />
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(SelectedToPartyBalance?.ToString("N2") ?? "0.00")</div>
                }
                else
                {
                    <SearchSelect TItem="ChartOfAccountDto" Items="_accounts" IdSelector="@(a => a.Id)" TextSelector="@DisplayText.Account" Value="@(_toAccountId ?? 0)" ValueChanged="@(v => _toAccountId = v)" Placeholder="Search account…" />
                    <div class="batch-readonly-figure" style="margin-top:6px;">Balance: Rs @(SelectedToAccountBalance?.ToString("N2") ?? "0.00")</div>
                }
            </div>

            <div><label>Amount</label><input type="number" step="0.01" @bind="_amount" /></div>
            <div><label>Ref No</label><input @bind="_refNo" style="width:160px;" /></div>
            <div style="grid-column: span 2;"><label>Description</label><input @bind="_description" style="width:100%;" /></div>

            <div style="grid-column: span 2;">
                <button class="btn" disabled="@(_amount <= 0)" @onclick="SaveAsync">@(_editingVoucherId is null ? "Save" : "Update") @Title</button>
                @if (_editingVoucherId is not null)
                {
                    <button class="btn secondary" @onclick="ResetFormToNew">Cancel Edit / New Voucher</button>
                }
            </div>
        </div>
    </div>

    <div>
        <h3 style="margin-top:0;">@(Title)s on @_date.ToString("yyyy-MM-dd")</h3>
        @if (_gridVouchers is null)
        {
            <p>Loading…</p>
        }
        else if (_gridVouchers.Count == 0)
        {
            <p style="color:#777;">No @(Title)s on @_date.ToString("yyyy-MM-dd").</p>
        }
        else
        {
            <div class="batch-results-grid-wrapper" style="max-height:65vh;overflow-y:auto;">
                <table class="data-grid">
                    <thead><tr><th>Voucher #</th><th>From</th><th>To</th><th style="text-align:right;">Amount</th><th>Description</th></tr></thead>
                    <tbody>
                        @foreach (var v in _gridVouchers)
                        {
                            <tr>
                                <td><a href="print/voucher/@v.Id">@v.VoucherNo</a></td>
                                <td>@(v.FromPartyName ?? v.FromAccountName ?? v.FromType?.ToString())</td>
                                <td>@(v.ToPartyName ?? v.ToAccountName ?? v.ToType?.ToString())</td>
                                <td style="text-align:right;">@v.Amount.ToString("N2")</td>
                                <td>@(v.Description ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:600;">
                            <td colspan="3">Total</td>
                            <td style="text-align:right;">@_gridVouchers.Sum(v => v.Amount).ToString("N2")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public VoucherType VoucherKind { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _parties;
    private List<ChartOfAccountDto>? _accounts;
    private List<VoucherDto>? _gridVouchers;
    private string? _reservedVoucherNo;
    private string? _error;
    private string? _successMessage;

    private string? _searchVoucherNo;
    private int? _editingVoucherId;
    private string? _editingVoucherNo;

    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private decimal _amount;
    private string? _refNo;
    private string? _description;

    private LedgerPartyRefType _fromType;
    private int? _fromPartyId;
    private int? _fromAccountId;
    private LedgerPartyRefType _toType;
    private int? _toPartyId;
    private int? _toAccountId;

    private string? DisplayedVoucherNo => _editingVoucherId is not null ? _editingVoucherNo : _reservedVoucherNo;

    private decimal? SelectedFromPartyBalance => _parties?.FirstOrDefault(p => p.Id == _fromPartyId)?.CurrentBalance;
    private decimal? SelectedFromAccountBalance => _accounts?.FirstOrDefault(a => a.Id == _fromAccountId)?.CurrentBalance;
    private decimal? SelectedToPartyBalance => _parties?.FirstOrDefault(p => p.Id == _toPartyId)?.CurrentBalance;
    private decimal? SelectedToAccountBalance => _accounts?.FirstOrDefault(a => a.Id == _toAccountId)?.CurrentBalance;

    private ChartOfAccountDto? FixedAccountFor(LedgerPartyRefType type) =>
        _accounts?.FirstOrDefault(a => a.Code == (type == LedgerPartyRefType.Cash ? DomainConstants.CashAccountCode : DomainConstants.BankAccountCode));

    protected override async Task OnInitializedAsync()
    {
        // Sets the From/To direction defaults synchronously so the first render (before the loads
        // below complete) never shows an unset enum value in the From/To dropdowns.
        ResetFormToNew();

        try
        {
            // Season is never user-picked here — GetSeasonsAsync orders by StartDate descending, so
            // the first row is always the current/most-recent season; just use it.
            _seasons = await Api.GetSeasonsAsync();
            _parties = await Api.GetPartiesAsync();
            _accounts = await Api.GetChartOfAccountsAsync();
            ResetFormToNew();
            await ReserveVoucherNoAsync();
            await LoadGridVouchersAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") SearchGridVoucher();
    }

    // Looks up the entered number only among the vouchers currently shown in the grid (same kind,
    // same date as the form's own Date field) — never the full voucher history — and loads it into
    // the form fields for editing in place via UpdateVoucherAsync.
    private void SearchGridVoucher()
    {
        _error = null;
        _successMessage = null;
        if (string.IsNullOrWhiteSpace(_searchVoucherNo)) return;

        var match = _gridVouchers?.FirstOrDefault(v => string.Equals(v.VoucherNo, _searchVoucherNo.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match is null)
        {
            _error = $"No {Title} numbered \"{_searchVoucherNo}\" found on {_date:yyyy-MM-dd}.";
            return;
        }

        _editingVoucherId = match.Id;
        _editingVoucherNo = match.VoucherNo;
        _date = match.Date;
        _seasonId = match.SeasonId;
        _refNo = match.RefNo;
        _description = match.Description;
        _amount = match.Amount;
        _fromType = match.FromType ?? _fromType;
        _fromPartyId = match.FromPartyId;
        _fromAccountId = match.FromAccountId;
        _toType = match.ToType ?? _toType;
        _toPartyId = match.ToPartyId;
        _toAccountId = match.ToAccountId;
        _successMessage = $"Editing {match.VoucherNo} — make changes and click Update {Title}.";
    }

    private void ResetFormToNew()
    {
        _editingVoucherId = null;
        _editingVoucherNo = null;
        _searchVoucherNo = null;
        _date = DateTime.Today;
        if (_seasons?.Count > 0) _seasonId = _seasons[0].Id;
        _amount = 0;
        _refNo = null;
        _description = null;

        // Payment pays FROM cash/bank TO a party by default; Receipt is the mirror image — money
        // comes FROM a party TO cash/bank — matching the Dr-the-To/Cr-the-From posting convention
        // for both (see VoucherService), so the default direction is always the common case instead
        // of making every Receipt start backwards and need both dropdowns flipped by hand.
        _fromType = VoucherKind == VoucherType.Receipt ? LedgerPartyRefType.Party : LedgerPartyRefType.Cash;
        _toType = VoucherKind == VoucherType.Receipt ? LedgerPartyRefType.Cash : LedgerPartyRefType.Party;
        if (_parties?.Count > 0) { _fromPartyId = _parties[0].Id; _toPartyId = _parties[0].Id; }
        if (_accounts?.Count > 0) { _fromAccountId = _accounts[0].Id; _toAccountId = _accounts[0].Id; }
    }

    private async Task ReserveVoucherNoAsync()
    {
        var next = VoucherKind == VoucherType.Payment ? await Api.ReserveNextPaymentNoAsync() : await Api.ReserveNextReceiptNoAsync();
        _reservedVoucherNo = next.VoucherNo;
    }

    private async Task LoadGridVouchersAsync()
    {
        var all = await Api.GetVouchersAsync(VoucherKind);
        _gridVouchers = all.Where(v => v.Date.Date == _date.Date).OrderByDescending(v => v.Id).ToList();
    }

    private async Task SaveAsync()
    {
        _error = null;
        _successMessage = null;
        try
        {
            if (_editingVoucherId is not null)
            {
                var request = new UpdatePaymentOrReceiptRequest(
                    _date, _seasonId, _amount, _refNo, _description,
                    _fromType, _fromPartyId, _fromAccountId,
                    _toType, _toPartyId, _toAccountId);
                var result = await Api.UpdateVoucherAsync(_editingVoucherId.Value, request);
                _successMessage = $"{Title} {result.VoucherNo} updated.";
                ResetFormToNew();
            }
            else
            {
                var request = new CreatePaymentOrReceiptRequest(
                    VoucherKind, _date, _seasonId, _amount, _refNo, _description,
                    _fromType, _fromPartyId, _fromAccountId,
                    _toType, _toPartyId, _toAccountId,
                    _reservedVoucherNo);
                var result = VoucherKind == VoucherType.Payment ? await Api.CreatePaymentAsync(request) : await Api.CreateReceiptAsync(request);
                _successMessage = $"{Title} {result.VoucherNo} saved.";
                ResetFormToNew();
                await ReserveVoucherNoAsync();
            }
            await LoadGridVouchersAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
