@page "/reports/party-account"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <h1 class="page-title">Party Account Statement</h1>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    <div class="no-print" style="max-width:900px;margin-bottom:16px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
            <button class="btn secondary" @onclick="() => _filtersExpanded = !_filtersExpanded">
                @(_filtersExpanded ? "▾" : "▸") Filters
                @if (!_filtersExpanded && _ledger is not null)
                {
                    <span style="font-weight:400;color:#666;">
                        &nbsp;— @AccountTypeLabel: @_ledger.PartyName, @(_from?.ToString("yyyy-MM-dd") ?? "Start") to @(_to?.ToString("yyyy-MM-dd") ?? "Today")
                    </span>
                }
            </button>
            @if (_ledger is not null)
            {
                <button class="btn" @onclick="PrintAsync">Print</button>
            }
        </div>

        @if (_filtersExpanded)
        {
            <div class="form-grid">
                <div>
                    <label>Account Type</label>
                    <SearchSelect TItem="AccountTypeOption" Items="AccountTypeOptions" IdSelector="@(o => o.Id)" TextSelector="@(o => o.Label)" Value="@_accountTypeId" ValueChanged="@OnAccountTypeChangedAsync" Placeholder="Select…" />
                </div>
                <div>
                    <label>@AccountTypeLabel</label>
                    <SearchSelect TItem="PartyDto" Items="_parties" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Party" @bind-Value="_partyId" Placeholder="Search…" />
                </div>
                <div><label>From</label><input type="date" @bind="_from" /></div>
                <div><label>To</label><input type="date" @bind="_to" /></div>
                <div style="grid-column: span 2;">
                    <button class="btn" @onclick="LoadAsync">Show Account</button>
                </div>
            </div>
        }
    </div>

    @if (_ledger is not null)
    {
        <div class="print-a4-report" style="background:white;padding:20px;border:1px solid #ccc;margin-top:16px;">
            <div style="border:1px solid #000;padding:8px 10px;">
                <div style="text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:1.3rem;font-weight:700;">@_companyInfo?.NameEnglish</div>
                @if (!string.IsNullOrWhiteSpace(_companyInfo?.MarketName))
                {
                    <div style="text-align:center;font-size:0.9rem;">@_companyInfo.MarketName</div>
                }
                @if (ContactLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.75rem;">@ContactLine</div>
                }
                @if (ProprietorLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.8rem;">@ProprietorLine</div>
                }
            </div>
            <div style="text-align:center;color:#666;margin-top:6px;">@AccountTypeLabel Account Statement</div>
            <hr />
            <table style="width:100%;margin-bottom:10px;">
                <tr>
                    <td><b>@_ledger.PartyName</b></td>
                    <td style="text-align:right;">@(_from?.ToString("yyyy-MM-dd") ?? "Start") to @(_to?.ToString("yyyy-MM-dd") ?? "Today")</td>
                </tr>
                <tr>
                    <td>Opening Balance: <b>@_ledger.OpeningBalance.ToString("N2")</b></td>
                    <td style="text-align:right;">Closing Balance: <b>@_ledger.ClosingBalance.ToString("N2")</b></td>
                </tr>
            </table>
            @if (_ledger.Rows.Count == 0)
            {
                <p style="color:#777;">No transactions in this period.</p>
            }
            else
            {
                <table class="data-grid" style="width:100%;">
                    <thead><tr><th>Date &amp; Time</th><th>Invoice / Voucher #</th><th>Description</th><th style="text-align:right;">Debit</th><th style="text-align:right;">Credit</th><th style="text-align:right;">Balance</th></tr></thead>
                    <tbody>
                        @foreach (var r in _ledger.Rows)
                        {
                            <tr>
                                <td>@r.Date.ToString("yyyy-MM-dd") <span style="color:#777;">@LocalTime(r.CreatedAtUtc).ToString("HH:mm")</span></td>
                                <td>@(r.ReferenceNo ?? "—")</td>
                                <td>@r.Description</td>
                                <td style="text-align:right;">@(r.Debit > 0 ? r.Debit.ToString("N2") : "")</td>
                                <td style="text-align:right;">@(r.Credit > 0 ? r.Credit.ToString("N2") : "")</td>
                                <td style="text-align:right;">@r.RunningBalance.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
</RequireAuth>

@code {
    private List<PartyDto>? _parties;
    private PartyLedgerDto? _ledger;
    private CompanyInfoDto? _companyInfo;
    private string? _error;
    private bool _filtersExpanded = true;

    private record AccountTypeOption(int Id, PartyType Type, string Label);
    private static readonly List<AccountTypeOption> AccountTypeOptions = new()
    {
        new(0, PartyType.Farmer, "Farmer"),
        new(1, PartyType.Vendor, "Grain Buyer"),
        new(2, PartyType.Supplier, "Supplier")
    };

    private int _accountTypeId;
    private PartyType _partyType = PartyType.Farmer;
    private int _partyId;
    private DateTime? _from;
    private DateTime? _to;

    private string AccountTypeLabel => AccountTypeOptions[_accountTypeId].Label;

    // CreatedAtUtc always comes back Kind-unspecified from EF/Npgsql even though it was stamped
    // with DateTime.UtcNow at insert time — SpecifyKind makes that explicit before converting, so
    // this always reflects the device's local time regardless of how the value round-tripped.
    private static DateTime LocalTime(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime();

    private string ContactLine => string.Join("  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.Phone) ? null : $"Phone: {_companyInfo.Phone}",
        string.IsNullOrWhiteSpace(_companyInfo?.Mobile) ? null : $"Mobile: {_companyInfo.Mobile}",
        string.IsNullOrWhiteSpace(_companyInfo?.Email) ? null : $"Email: {_companyInfo.Email}"
    }.Where(s => s is not null));

    private string ProprietorLine => string.Join("  |  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.ProprietorName) ? null : $"Proprietor: {_companyInfo.ProprietorName}",
        string.IsNullOrWhiteSpace(_companyInfo?.NtnNumber) ? null : $"NTN No: {_companyInfo.NtnNumber}"
    }.Where(s => s is not null));

    protected override async Task OnInitializedAsync()
    {
        await LoadPartiesAsync();
        try { _companyInfo = await Api.GetCompanyInfoAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task LoadPartiesAsync()
    {
        try
        {
            _parties = await Api.GetPartiesAsync(_partyType);
            _partyId = _parties.Count > 0 ? _parties[0].Id : 0;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task OnAccountTypeChangedAsync(int id)
    {
        _accountTypeId = id;
        _partyType = AccountTypeOptions[id].Type;
        _ledger = null;
        await LoadPartiesAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _ledger = null;
        if (_partyId == 0) { _error = $"Pick a {AccountTypeLabel.ToLowerInvariant()} first."; return; }
        try
        {
            _ledger = await Api.GetPartyLedgerAsync(_partyId, _from, _to);
            _filtersExpanded = false;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
}
