@page "/sale-invoice"
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">New Sale (General)</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    <div class="form-grid" style="max-width:1100px;">
        <div><label>Bill No</label><input @bind="_billNo" /></div>
        <div><label>Date</label><input type="date" @bind="_date" /></div>
        <div>
            <label>Customer</label>
            <select @bind="_customerId">
                @if (_customers is not null) { @foreach (var c in _customers) { <option value="@c.Id">@c.Name</option> } }
            </select>
        </div>
        <div>
            <label>Print Format</label>
            <select @bind="_printFormat">
                <option value="@PrintFormat.Thermal">Thermal</option>
                <option value="@PrintFormat.A4">A4</option>
            </select>
        </div>
        <div>
            <label>Print Language</label>
            <select @bind="_printLanguage">
                <option value="@PrintLanguage.English">English</option>
                <option value="@PrintLanguage.Urdu">Urdu</option>
            </select>
        </div>
    </div>

    <table class="data-grid" style="max-width:1100px;margin-top:14px;">
        <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Discount %</th><th>Net</th><th></th></tr></thead>
        <tbody>
            @for (var i = 0; i < _lines.Count; i++)
            {
                var index = i;
                var line = _lines[index];
                <tr>
                    <td>
                        <select value="@line.ProductId" @onchange="e => line.ProductId = int.Parse((string)e.Value!)">
                            @if (_products is not null) { @foreach (var p in _products) { <option value="@p.Id">@p.Name</option> } }
                        </select>
                    </td>
                    <td><input type="number" step="0.01" value="@line.Quantity" @onchange="e => line.Quantity = ParseDecimal(e.Value)" /></td>
                    <td><input type="number" step="0.01" value="@line.Price" @onchange="e => line.Price = ParseDecimal(e.Value)" /></td>
                    <td><input type="number" step="0.01" value="@line.DiscountPercent" @onchange="e => line.DiscountPercent = ParseDecimal(e.Value)" /></td>
                    <td>@LineNet(line).ToString("N2")</td>
                    <td><button class="btn danger" @onclick="() => _lines.RemoveAt(index)">Remove</button></td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn secondary" style="margin-top:8px;" @onclick="AddLine">+ Add Line</button>

    <div class="form-grid" style="max-width:1100px;margin-top:14px;">
        <div class="total-figure">Total Bill: Rs @TotalBill.ToString("N2")</div>
        <div><label>Received Cash</label><input type="number" step="0.01" @bind="_receivedCash" /></div>
        <div style="grid-column: span 2;">
            @if (_lines.Count == 0)
            {
                <div class="invalid-total">Add at least one line item.</div>
            }
            <button class="btn" disabled="@(_lines.Count == 0)" @onclick="SaveAsync">Save Sale Invoice</button>
        </div>
    </div>

    @if (_invoices is not null)
    {
        <h3 style="margin-top:24px;">Recent Sale Invoices</h3>
        <table class="data-grid" style="max-width:1100px;">
            <thead><tr><th>Invoice</th><th>Date</th><th>Customer</th><th>Net Bill</th><th>Received</th></tr></thead>
            <tbody>
                @foreach (var inv in _invoices)
                {
                    <tr>
                        <td>@inv.InvoiceNo</td>
                        <td>@inv.Date.ToString("yyyy-MM-dd")</td>
                        <td>@inv.CustomerName</td>
                        <td>@inv.NetBill.ToString("N2")</td>
                        <td>@inv.ReceivedCash.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    private List<PartyDto>? _customers;
    private List<ProductDto>? _products;
    private List<SaleInvoiceDto>? _invoices;
    private string? _error;

    private string? _billNo;
    private DateTime _date = DateTime.Today;
    private int _customerId;
    private PrintFormat _printFormat = PrintFormat.Thermal;
    private PrintLanguage _printLanguage = PrintLanguage.English;
    private decimal _receivedCash;
    private readonly List<LineModel> _lines = new();

    private decimal TotalBill => _lines.Sum(LineNet);

    protected override async Task OnInitializedAsync()
    {
        _customers = await Api.GetPartiesAsync();
        _products = await Api.GetProductsAsync();
        if (_customers.Count > 0) _customerId = _customers[0].Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _invoices = await Api.GetSaleInvoicesAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void AddLine() => _lines.Add(new LineModel { ProductId = _products?.FirstOrDefault()?.Id ?? 0, Quantity = 1 });

    private static decimal LineNet(LineModel l)
    {
        var gross = l.Quantity * l.Price;
        return gross - gross * (l.DiscountPercent / 100m);
    }

    private static decimal ParseDecimal(object? value) => decimal.TryParse(value?.ToString(), out var d) ? d : 0;

    private async Task SaveAsync()
    {
        _error = null;
        var request = new CreateSaleInvoiceRequest(
            _date, _billNo, _customerId,
            _lines.Select(l => new SaleInvoiceLineRequest(l.ProductId, l.Quantity, l.Price, l.DiscountPercent)).ToList(),
            _receivedCash, _printFormat, _printLanguage);
        try
        {
            await Api.CreateSaleInvoiceAsync(request);
            _lines.Clear();
            _receivedCash = 0;
            _billNo = null;
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private class LineModel
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal Price { get; set; }
        public decimal DiscountPercent { get; set; }
    }
}
