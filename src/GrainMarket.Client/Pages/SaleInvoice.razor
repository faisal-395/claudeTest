@page "/sale-invoice"
@using GrainMarket.Application.Common
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <h1 class="page-title" style="margin-bottom:4px;">Sale Invoice</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_successMessage is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
    }

    <div class="batch-entry-panel">
        <div class="batch-entry-inputs">
            <div class="batch-entry-row batch-entry-row-auto">
                <div><label>Invoice #</label><div class="batch-readonly-figure">@(_reservedInvoiceNo ?? "…")</div></div>
                <div><label>Bill No</label><input @bind="_billNo" /></div>
                <div><label>Date</label><input type="date" @bind="_date" /></div>
                <div>
                    <label>Customer (Farmer)</label>
                    <SearchSelect TItem="PartyDto" Items="_customers" IdSelector="@(c => c.Id)" TextSelector="@DisplayText.Party" @bind-Value="_customerId" Placeholder="Search farmer…" />
                </div>
                <div><label>Balance</label><div class="batch-readonly-figure">Rs @SelectedCustomerBalance.ToString("N2")</div></div>
            </div>
            <div class="batch-entry-section-label">Add Product</div>
            <div class="batch-entry-row batch-entry-row-auto">
                <div>
                    <label>Product</label>
                    <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" Value="@_stagingProductId" ValueChanged="OnStagingProductChangedAsync" Placeholder="Search product…" />
                </div>
                <div>
                    <label>In Stock</label>
                    <div class="batch-readonly-figure @(_stagingQuantity > AvailableFor(_stagingProductId) ? "invalid-total" : "")">@AvailableFor(_stagingProductId).ToString("N2")</div>
                </div>
                <div><label>Quantity</label><input type="number" step="0.01" @bind="_stagingQuantity" /></div>
                <div>
                    <label>Price</label>
                    <input type="number" step="0.01" value="@_stagingPrice" @onchange="e => { _stagingPrice = ParseDecimal(e.Value); _stagingManuallyPriced = true; }" title="Auto-filled from the product's sale price/markup setting — edit to override" />
                </div>
                <div><label>Discount %</label><input type="number" step="0.01" @bind="_stagingDiscountPercent" /></div>
            </div>
        </div>
    </div>

    <div class="batch-add-calc-row">
        <div class="batch-add-col">
            <button class="btn secondary" disabled="@(!CanAddStagedLine)" @onclick="AddStagedLineAsync">Add</button>
        </div>
        <div class="batch-staging-calc">
            <span>Net Price: <b>Rs @StagingUnitNetPrice.ToString("N2")</b></span>
            <span>&nbsp;·&nbsp;Line Total: <b>Rs @StagingLineNet.ToString("N2")</b></span>
        </div>
    </div>

    <div class="batch-results-grid-wrapper">
        <table class="data-grid batch-results-grid">
            <thead>
                <tr>
                    <th>Code</th><th>Product Name</th><th>Category</th><th>Quantity</th><th>Price</th>
                    <th>Discount</th><th>Net Price</th><th>T. Price</th><th>T. Discount</th><th>T. Net Price</th><th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _lines.Count; i++)
                {
                    var index = i;
                    var line = _lines[index];
                    <tr>
                        <td>@line.ProductId</td>
                        <td>@ProductName(line.ProductId)</td>
                        <td>@ProductCategory(line.ProductId)</td>
                        <td>
                            @line.Quantity.ToString("N2")
                            @if (IsOverStock(line))
                            {
                                <span class="invalid-total"> (over stock)</span>
                            }
                        </td>
                        <td>@line.Price.ToString("N2")</td>
                        <td>@line.DiscountPercent.ToString("N2")%</td>
                        <td>@UnitNetPrice(line).ToString("N2")</td>
                        <td>@LineGross(line).ToString("N2")</td>
                        <td>@LineDiscountAmount(line).ToString("N2")</td>
                        <td>@LineNet(line).ToString("N2")</td>
                        <td><a href="#" @onclick="() => _lines.RemoveAt(index)" @onclick:preventDefault="true">Remove</a></td>
                    </tr>
                }
                @if (_lines.Count == 0)
                {
                    <tr><td colspan="11" style="text-align:center;color:#999;">No lines added yet.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="batch-save-totals-row">
        <div class="batch-save-col">
            <button class="btn" disabled="@(!CanSave)" @onclick="() => SaveAsync(andPrint: false)">Save</button>
            <button class="btn" disabled="@(!CanSave)" @onclick="() => SaveAsync(andPrint: true)">Save &amp; Print</button>
        </div>
        <div class="batch-grand-totals">
            <span>Total Items: <b>@_lines.Count</b></span>
            <span>Total Quantity: <b>@_lines.Sum(l => l.Quantity).ToString("N2")</b></span>
            <span>Total Bill: <b>Rs @TotalGross.ToString("N2")</b></span>
            <span>Total Discount: <b>Rs @TotalDiscountAmount.ToString("N2")</b></span>
            <span>Net Bill: <b>Rs @NetBill.ToString("N2")</b></span>
        </div>
    </div>
    @if (_lines.Count == 0)
    {
        <div class="invalid-total">Add at least one line item.</div>
    }
    else if (HasStockIssue)
    {
        <div class="invalid-total">One or more lines exceed the available stock. Reduce the quantity or check the Stock page.</div>
    }

    <div class="form-grid" style="max-width:1100px;margin-top:14px;">
        <div style="grid-column: span 2;"><label>Description</label><input @bind="_description" style="width:100%;" /></div>
        <div><label>Received Cash</label><input type="number" step="0.01" @bind="_receivedCash" /></div>
    </div>
</RequireAuth>

@code {
    private List<PartyDto>? _customers;
    private List<ProductDto>? _products;
    private Dictionary<int, decimal> _stock = new();
    private string? _error;
    private string? _successMessage;
    private string? _reservedInvoiceNo;

    private string? _billNo;
    private DateTime _date = DateTime.Today;
    private string? _description;
    private int _customerId;
    private decimal _receivedCash;
    private readonly List<LineModel> _lines = new();

    private int _stagingProductId;
    private decimal _stagingQuantity = 1;
    private decimal _stagingPrice;
    private decimal _stagingDiscountPercent;
    private bool _stagingManuallyPriced;

    private decimal SelectedCustomerBalance => _customers?.FirstOrDefault(c => c.Id == _customerId)?.CurrentBalance ?? 0;

    private bool CanAddStagedLine => _stagingProductId > 0 && _stagingQuantity > 0;

    private bool CanSave => _lines.Count > 0 && !HasStockIssue;

    private decimal StagingUnitNetPrice => UnitNetPrice(_stagingPrice, _stagingDiscountPercent);

    private decimal StagingLineNet => LineNet(_stagingQuantity, _stagingPrice, _stagingDiscountPercent);

    private decimal TotalGross => _lines.Sum(LineGross);
    private decimal TotalDiscountAmount => _lines.Sum(LineDiscountAmount);
    private decimal NetBill => TotalGross - TotalDiscountAmount;

    private Dictionary<int, decimal> RequestedByProduct =>
        _lines.GroupBy(l => l.ProductId).ToDictionary(g => g.Key, g => g.Sum(l => l.Quantity));

    private decimal AvailableFor(int productId) => _stock.GetValueOrDefault(productId);

    private bool IsOverStock(LineModel line) => RequestedByProduct.GetValueOrDefault(line.ProductId) > AvailableFor(line.ProductId);

    private bool HasStockIssue => _lines.Any(IsOverStock);

    private string ProductName(int productId) => _products?.FirstOrDefault(p => p.Id == productId) is { } p ? DisplayText.Product(p) : "—";

    private string ProductCategory(int productId) => _products?.FirstOrDefault(p => p.Id == productId)?.Category ?? "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _customers = await Api.GetPartiesAsync(PartyType.Farmer);
            _products = await Api.GetProductsAsync(category: DomainConstants.ProductCategoryInput);
            _stock = (await Api.GetStockAsync()).ToDictionary(s => s.ProductId, s => s.OnHandQty);
            _reservedInvoiceNo = (await Api.ReserveNextSaleInvoiceNoAsync()).InvoiceNo;
            if (_customers.Count > 0) _customerId = _customers[0].Id;
            if (_products.Count > 0) _stagingProductId = _products[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; return; }
        await RefreshStagingSuggestedPriceAsync();
    }

    private async Task OnStagingProductChangedAsync(int productId)
    {
        _stagingProductId = productId;
        _stagingManuallyPriced = false;
        await RefreshStagingSuggestedPriceAsync();
    }

    /// <summary>Auto-fills Price from the product's SalePrice/SaleMarkupPercent setting, based on the
    /// single most recent purchase price for the product (LIFO — a new purchase immediately becomes
    /// the pricing basis) so the operator doesn't have to type one for every line — but never
    /// overwrites a price they've edited by hand.</summary>
    private async Task RefreshStagingSuggestedPriceAsync()
    {
        if (_stagingProductId <= 0 || _stagingManuallyPriced) return;
        try
        {
            var suggestion = await Api.GetSuggestedSalePriceAsync(_stagingProductId);
            _stagingPrice = suggestion.SuggestedPrice;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task AddStagedLineAsync()
    {
        _lines.Add(new LineModel { ProductId = _stagingProductId, Quantity = _stagingQuantity, Price = _stagingPrice, DiscountPercent = _stagingDiscountPercent });

        _stagingProductId = _products?.FirstOrDefault()?.Id ?? 0;
        _stagingQuantity = 1;
        _stagingPrice = 0;
        _stagingDiscountPercent = 0;
        _stagingManuallyPriced = false;
        await RefreshStagingSuggestedPriceAsync();
    }

    private static decimal UnitNetPrice(decimal price, decimal discountPercent) => price - price * (discountPercent / 100m);
    private static decimal UnitNetPrice(LineModel l) => UnitNetPrice(l.Price, l.DiscountPercent);

    private static decimal LineGross(LineModel l) => Math.Round(l.Quantity * l.Price, 2);
    private static decimal LineDiscountAmount(LineModel l) => Math.Round(LineGross(l) * (l.DiscountPercent / 100m), 2);
    private static decimal LineNet(LineModel l) => LineGross(l) - LineDiscountAmount(l);

    private static decimal LineNet(decimal quantity, decimal price, decimal discountPercent)
    {
        var gross = Math.Round(quantity * price, 2);
        var discount = Math.Round(gross * (discountPercent / 100m), 2);
        return gross - discount;
    }

    private static decimal ParseDecimal(object? value) => decimal.TryParse(value?.ToString(), out var d) ? d : 0;

    private async Task SaveAsync(bool andPrint)
    {
        _error = null;
        _successMessage = null;
        var request = new CreateSaleInvoiceRequest(
            _date, _billNo, _customerId,
            _lines.Select(l => new SaleInvoiceLineRequest(l.ProductId, l.Quantity, l.Price, l.DiscountPercent)).ToList(),
            _receivedCash, PrintFormat.Thermal, PrintLanguage.English, _description, _reservedInvoiceNo);
        try
        {
            var result = await Api.CreateSaleInvoiceAsync(request);
            if (andPrint)
            {
                Nav.NavigateTo($"print/sale/{result.Id}");
                return;
            }
            _successMessage = $"Sale Invoice {result.InvoiceNo} saved. See it under Records Report.";
            _lines.Clear();
            _receivedCash = 0;
            _billNo = null;
            _description = null;
            _stock = (await Api.GetStockAsync()).ToDictionary(s => s.ProductId, s => s.OnHandQty);
            _reservedInvoiceNo = (await Api.ReserveNextSaleInvoiceNoAsync()).InvoiceNo;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private class LineModel
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal Price { get; set; }
        public decimal DiscountPercent { get; set; }
    }
}
