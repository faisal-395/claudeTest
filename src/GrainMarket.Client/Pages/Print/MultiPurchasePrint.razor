@page "/print/multi-purchase"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn" @onclick="PrintAsync">Print</button>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_kachis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="no-print" style="background:#eaf7ee;border:1px solid #b6e3c2;padding:10px 14px;margin-bottom:14px;">
            Each row below is its own Kachi. <a href="kachi-records">View / edit all Kachi records</a>.
        </div>

        <div class="print-a4 rtl-urdu" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="text-align:center;font-size:1.3rem;font-weight:700;">عمر فاروق اینڈ برادرز</div>
            <div style="text-align:center;">کچی رسید — کئی کسان</div>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>خریدار: @(_kachis[0].BuyerName ?? "—")</td>
                    <td>تاریخ: <span class="ltr-inline">@_kachis[0].Date.ToString("yyyy-MM-dd")</span></td>
                </tr>
                @if (_kachis[0].ReceiptNumber is not null)
                {
                    <tr>
                        <td colspan="2">رسید نمبر: <span class="ltr-inline">@_kachis[0].ReceiptNumber</span></td>
                    </tr>
                }
            </table>
            <hr />
            @foreach (var k in _kachis)
            {
                <table style="width:100%;margin-bottom:10px;">
                    <tr>
                        <td>نمبر: <span class="ltr-inline">@k.InvoiceNo</span></td>
                        <td>کسان: @k.FarmerName</td>
                        <td>جنس: @k.ProductName</td>
                    </tr>
                    <tr>
                        <td>کل وزن (کلو): <span class="ltr-inline">@k.NetWeightKg.ToString("N2")</span></td>
                        <td>ریٹ فی مَن: <span class="ltr-inline">@(k.RatePerUnit?.ToString("N2") ?? "طے نہیں")</span></td>
                        <td>مجموعی رقم: <span class="ltr-inline">@k.GrossAmount.ToString("N2")</span></td>
                    </tr>
                </table>
                <table style="width:100%;margin-bottom:6px;">
                    @foreach (var line in k.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Farmer))
                    {
                        <tr><td>@line.NameUrdu</td><td class="ltr-inline">@line.Amount.ToString("N2")</td></tr>
                    }
                    <tr><td><b>مجموعی کٹوتی</b></td><td class="ltr-inline"><b>@k.TotalDeductions.ToString("N2")</b></td></tr>
                    <tr><td><b>کل رقم (کسان)</b></td><td class="ltr-inline"><b>@k.Total.ToString("N2")</b></td></tr>
                    @if (k.DeductionLines.Any(l => l.ChargedTo == DeductionChargedTo.Buyer))
                    {
                        <tr><td colspan="2"><b>خریدار کے ذمہ</b></td></tr>
                        @foreach (var line in k.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Buyer))
                        {
                            <tr><td>@line.NameUrdu</td><td class="ltr-inline">@line.Amount.ToString("N2")</td></tr>
                        }
                        <tr><td><b>کل (خریدار)</b></td><td class="ltr-inline"><b>@k.BuyerChargesTotal.ToString("N2")</b></td></tr>
                    }
                </table>
                <hr />
            }
            <table style="width:100%;">
                <tr><td><b>مجموعی رقم (کل)</b></td><td class="ltr-inline"><b>@_kachis.Sum(k => k.GrossAmount).ToString("N2")</b></td></tr>
                <tr><td><b>مجموعی کٹوتی (کل)</b></td><td class="ltr-inline"><b>@_kachis.Sum(k => k.TotalDeductions).ToString("N2")</b></td></tr>
                <tr><td><b>مجموعی کل رقم (کسان)</b></td><td class="ltr-inline"><b>@_kachis.Sum(k => k.Total).ToString("N2")</b></td></tr>
                @if (_kachis.Sum(k => k.BuyerChargesTotal) > 0)
                {
                    <tr><td><b>مجموعی خریدار چارجز</b></td><td class="ltr-inline"><b>@_kachis.Sum(k => k.BuyerChargesTotal).ToString("N2")</b></td></tr>
                }
            </table>
        </div>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery] public string? Ids { get; set; }

    private List<KachiDto>? _kachis;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var ids = (Ids ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();

        if (ids.Count == 0)
        {
            _error = "No receipts to show — this page expects one or more Kachi ids in the URL.";
            return;
        }

        try
        {
            var kachis = new List<KachiDto>();
            foreach (var id in ids)
            {
                kachis.Add(await Api.GetKachiAsync(id));
            }
            _kachis = kachis;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
}
