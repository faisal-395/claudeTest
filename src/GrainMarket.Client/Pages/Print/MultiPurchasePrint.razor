@page "/print/multi-purchase"
@using GrainMarket.Application.Common.Services
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn secondary" @onclick="GoBackAsync">← Back</button>
        <button class="btn" @onclick="PrintAsync">Print</button>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_kachis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="print-a4 print-a4-wide" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="border:1px solid #000;padding:8px 10px;">
                <div style="text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:1.5rem;font-weight:700;">@_companyInfo?.NameEnglish</div>
                @if (!string.IsNullOrWhiteSpace(_companyInfo?.MarketName))
                {
                    <div style="text-align:center;font-size:0.95rem;">@_companyInfo.MarketName</div>
                }
                @if (ContactLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.8rem;">@ContactLine</div>
                }
                @if (ProprietorLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.85rem;">@ProprietorLine</div>
                }
            </div>
            <div style="text-align:center;font-size:1.1rem;font-weight:700;text-decoration:underline;margin-top:10px;">Kachi Maal</div>
            <div style="text-align:center;font-size:0.85rem;margin-bottom:8px;">Date: @_kachis[0].Date.ToString("dd-MMM-yy")</div>

            <table style="width:100%;">
                <tr>
                    <td>Bill #: @_kachis[0].InvoiceNo</td>
                    <td>Buyer: @(_kachis[0].BuyerName ?? "—")</td>
                    <td>Product: @string.Join(", ", _kachis.Select(k => k.ProductName).Distinct())</td>
                </tr>
            </table>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>Weight (Kg): <b>@_kachis.Sum(k => k.NetWeightKg).ToString("N2")</b></td>
                    <td>Gross Amount: <b>@_kachis.Sum(k => k.GrossAmount).ToString("N2")</b></td>
                    <td>Deductions: <b>@_kachis.Sum(k => k.TotalDeductions).ToString("N2")</b></td>
                    <td>Net Bill: <b>@_kachis.Sum(k => k.Total).ToString("N2")</b></td>
                </tr>
                @if (BuyerChargeSummary.Count > 0)
                {
                    <tr>
                        <td colspan="4">
                            Buyer Charges: @string.Join(", ", BuyerChargeSummary.Select(x => $"{x.Name}: {x.Amount:N2}"))
                            — Total: <b>@_kachis.Sum(k => k.BuyerChargesTotal).ToString("N2")</b>
                        </td>
                    </tr>
                }
            </table>
            <hr />

            <table class="data-grid multi-print-grid" style="width:100%;">
                <thead>
                    <tr>
                        <th>Farmer</th>
                        <th>Rate</th>
                        <th>Bharti</th>
                        <th>Bori</th>
                        <th>Man</th>
                        <th>Dhrn</th>
                        <th>Kg</th>
                        <th>Weight</th>
                        <th>Price</th>
                        @foreach (var col in SellerDeductionColumns)
                        {
                            <th>@col.Name</th>
                        }
                        <th>Net Bill</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in _kachis)
                    {
                        var breakdown = ManDhrnKgBreakdown(k);
                        <tr>
                            <td>@k.FarmerName</td>
                            <td>@(k.RatePerUnit?.ToString("N2") ?? "-")</td>
                            <td>@(k.BhartiKgPerBag?.ToString("N2") ?? "-")</td>
                            <td>@(k.BoriQty?.ToString("N2") ?? "-")</td>
                            <td>@(breakdown?.ManCount.ToString() ?? "-")</td>
                            <td>@(breakdown?.DhrnCount.ToString() ?? "-")</td>
                            <td>@(breakdown?.KgRemainder.ToString("N2") ?? "-")</td>
                            <td>@k.NetWeightKg.ToString("N2")</td>
                            <td>@k.GrossAmount.ToString("N2")</td>
                            @foreach (var col in SellerDeductionColumns)
                            {
                                var amount = k.DeductionLines.FirstOrDefault(l => l.DeductionRuleId == col.RuleId)?.Amount;
                                <td>@(amount is { } a && a != 0 ? a.ToString("N2") : "-")</td>
                            }
                            <td><b>@k.Total.ToString("N2")</b></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="7"><b>Total</b></td>
                        <td><b>@_kachis.Sum(k => k.NetWeightKg).ToString("N2")</b></td>
                        <td><b>@_kachis.Sum(k => k.GrossAmount).ToString("N2")</b></td>
                        @foreach (var col in SellerDeductionColumns)
                        {
                            <td><b>@_kachis.Sum(k => k.DeductionLines.FirstOrDefault(l => l.DeductionRuleId == col.RuleId)?.Amount ?? 0).ToString("N2")</b></td>
                        }
                        <td><b>@_kachis.Sum(k => k.Total).ToString("N2")</b></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery] public string? Ids { get; set; }

    private List<KachiDto>? _kachis;
    private CompanyInfoDto? _companyInfo;
    private List<UnitConversion>? _unitConversionEntities;
    private string? _error;

    private string ContactLine => string.Join("  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.Phone) ? null : $"Phone: {_companyInfo.Phone}",
        string.IsNullOrWhiteSpace(_companyInfo?.Mobile) ? null : $"Mobile: {_companyInfo.Mobile}",
        string.IsNullOrWhiteSpace(_companyInfo?.Email) ? null : $"Email: {_companyInfo.Email}"
    }.Where(s => s is not null));

    private string ProprietorLine => string.Join("  |  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.ProprietorName) ? null : $"Proprietor: {_companyInfo.ProprietorName}",
        string.IsNullOrWhiteSpace(_companyInfo?.NtnNumber) ? null : $"NTN No: {_companyInfo.NtnNumber}"
    }.Where(s => s is not null));

    // One column per distinct deduction rule actually charged to the seller (farmer) across this
    // batch — whatever's configured in Setup > Format, not a fixed set — so the table always
    // matches what's really being deducted.
    private List<(int RuleId, string Name)> SellerDeductionColumns =>
        (_kachis ?? new())
            .SelectMany(k => k.DeductionLines)
            .Where(l => l.ChargedTo == DeductionChargedTo.Seller)
            .GroupBy(l => l.DeductionRuleId)
            .Select(g => (g.Key, g.First().Name))
            .OrderBy(x => x.Key)
            .ToList();

    // Buyer-charged deductions are invoice-level (one collection from the buyer, not per farmer),
    // so they're itemized in the summary block above rather than as extra table columns.
    private List<(string Name, decimal Amount)> BuyerChargeSummary =>
        (_kachis ?? new())
            .SelectMany(k => k.DeductionLines)
            .Where(l => l.ChargedTo == DeductionChargedTo.Buyer)
            .GroupBy(l => l.DeductionRuleId)
            .Select(g => (g.First().Name, g.Sum(l => l.Amount)))
            .OrderBy(x => x.Name)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var ids = (Ids ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();

        if (ids.Count == 0)
        {
            _error = "No receipts to show — this page expects one or more Kachi ids in the URL.";
            return;
        }

        try
        {
            var kachis = new List<KachiDto>();
            foreach (var id in ids)
            {
                kachis.Add(await Api.GetKachiAsync(id));
            }
            _kachis = kachis;
            _companyInfo = await Api.GetCompanyInfoAsync();

            var conversions = await Api.GetUnitConversionsAsync();
            _unitConversionEntities = conversions.Select(c => new UnitConversion
            {
                Id = c.Id, Unit = c.Unit, FactorToKg = c.FactorToKg, ProductId = c.ProductId, IsActive = c.IsActive
            }).ToList();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private (int ManCount, int DhrnCount, decimal KgRemainder)? ManDhrnKgBreakdown(KachiDto k)
    {
        if (_unitConversionEntities is null) return null;
        try
        {
            return UnitConversionCalculator.BreakdownIntoManDhrnKg(k.NetWeightKg, k.ProductId, _unitConversionEntities);
        }
        catch (Application.Common.Exceptions.InvalidCalculationException) { return null; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();

    // Uses real browser history instead of a hardcoded route — this page is reachable from the
    // combined Records Report, and "Back" should return there.
    private Task GoBackAsync() => JS.InvokeVoidAsync("history.back").AsTask();
}
