@page "/print/voucher/{Id:int}"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn secondary" @onclick="GoBackAsync">← Back</button>
        <button class="btn" @onclick="PrintAsync">Print</button>
        @if (_voucher is { IsCancelled: false })
        {
            <button class="btn danger" @onclick="CancelAsync">Cancel Voucher</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_voucher is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="print-a4" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="border:1px solid #000;padding:8px 10px;">
                <div style="text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:1.3rem;font-weight:700;">@_companyInfo?.NameEnglish</div>
                @if (!string.IsNullOrWhiteSpace(_companyInfo?.MarketName))
                {
                    <div style="text-align:center;font-size:0.9rem;">@_companyInfo.MarketName</div>
                }
                @if (ContactLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.75rem;">@ContactLine</div>
                }
                @if (ProprietorLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.8rem;">@ProprietorLine</div>
                }
            </div>
            <div style="text-align:center;color:#666;margin-top:6px;">@_voucher.VoucherType Voucher</div>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>Voucher #: <b>@_voucher.VoucherNo</b></td>
                    <td style="text-align:right;">Date: <b>@_voucher.Date.ToString("yyyy-MM-dd")</b></td>
                </tr>
                <tr>
                    <td>Season: <b>@_voucher.SeasonName</b></td>
                    <td style="text-align:right;">Status: <b>@(_voucher.IsCancelled ? "Cancelled" : "Open")</b></td>
                </tr>
                @if (_voucher.RefNo is { Length: > 0 })
                {
                    <tr>
                        <td colspan="2">Ref #: <b>@_voucher.RefNo</b></td>
                    </tr>
                }
            </table>
            <hr />
            @if (_voucher.VoucherType == VoucherType.Journal)
            {
                <table style="width:100%;">
                    <tr>
                        <td>Debit Account: <b>@_voucher.DebitAccountName</b></td>
                        <td style="text-align:right;">Credit Account: <b>@_voucher.CreditAccountName</b></td>
                    </tr>
                    @if (_voucher.DebitDescription is { Length: > 0 } || _voucher.CreditDescription is { Length: > 0 })
                    {
                        <tr>
                            <td>@(_voucher.DebitDescription ?? "—")</td>
                            <td style="text-align:right;">@(_voucher.CreditDescription ?? "—")</td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <table style="width:100%;">
                    <tr>
                        <td>From: <b>@(_voucher.FromPartyName ?? _voucher.FromAccountName ?? _voucher.FromType?.ToString())</b></td>
                        <td style="text-align:right;">To: <b>@(_voucher.ToPartyName ?? _voucher.ToAccountName ?? _voucher.ToType?.ToString())</b></td>
                    </tr>
                    @if (_voucher.Description is { Length: > 0 })
                    {
                        <tr>
                            <td colspan="2">Description: @_voucher.Description</td>
                        </tr>
                    }
                </table>
            }
            <hr />
            <table style="width:100%;">
                <tr><td><b>Amount</b></td><td style="text-align:right;"><b>@_voucher.Amount.ToString("N2")</b></td></tr>
            </table>
        </div>
    }
</RequireAuth>

@code {
    [Parameter] public int Id { get; set; }
    private VoucherDto? _voucher;
    private CompanyInfoDto? _companyInfo;
    private string? _error;

    private string ContactLine => string.Join("  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.Phone) ? null : $"Phone: {_companyInfo.Phone}",
        string.IsNullOrWhiteSpace(_companyInfo?.Mobile) ? null : $"Mobile: {_companyInfo.Mobile}",
        string.IsNullOrWhiteSpace(_companyInfo?.Email) ? null : $"Email: {_companyInfo.Email}"
    }.Where(s => s is not null));

    private string ProprietorLine => string.Join("  |  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.ProprietorName) ? null : $"Proprietor: {_companyInfo.ProprietorName}",
        string.IsNullOrWhiteSpace(_companyInfo?.NtnNumber) ? null : $"NTN No: {_companyInfo.NtnNumber}"
    }.Where(s => s is not null));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _voucher = await Api.GetVoucherAsync(Id);
            _companyInfo = await Api.GetCompanyInfoAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task CancelAsync()
    {
        _error = null;
        try
        {
            await Api.CancelVoucherAsync(Id);
            _voucher = await Api.GetVoucherAsync(Id);
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();

    // Uses real browser history instead of a hardcoded route — this page is reachable from Voucher
    // Records, and "Back" should return there.
    private Task GoBackAsync() => JS.InvokeVoidAsync("history.back").AsTask();
}
