@page "/print/kachi/{Id:int}"
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn secondary" @onclick='() => Nav.NavigateTo("/kachi-records")'>← Back to Kachi Records</button>
        <button class="btn" @onclick="PrintAsync">Print</button>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_kachi is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="print-a4 rtl-urdu" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="text-align:center;font-size:1.3rem;font-weight:700;">عمر فاروق اینڈ برادرز</div>
            <div style="text-align:center;">کچی رسید</div>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>نمبر: <span class="ltr-inline">@_kachi.InvoiceNo</span></td>
                    <td>تاریخ: <span class="ltr-inline">@_kachi.Date.ToString("yyyy-MM-dd")</span></td>
                </tr>
                @if (_kachi.ReceiptNumber is not null)
                {
                    <tr>
                        <td colspan="2">رسید نمبر: <span class="ltr-inline">@_kachi.ReceiptNumber</span></td>
                    </tr>
                }
                <tr>
                    <td>کسان: @_kachi.FarmerName</td>
                    <td>جنس: @_kachi.ProductName</td>
                </tr>
            </table>
            <hr />
            <table style="width:100%;">
                <tr><td>مَن</td><td class="ltr-inline">@(_kachi.ManQty?.ToString("N2") ?? "-")</td></tr>
                <tr><td>کلو</td><td class="ltr-inline">@(_kachi.KiloQty?.ToString("N2") ?? "-")</td></tr>
                <tr><td>گرام</td><td class="ltr-inline">@(_kachi.GramQty?.ToString("N2") ?? "-")</td></tr>
                <tr><td>بوری</td><td class="ltr-inline">@(_kachi.BoriQty?.ToString("N2") ?? "-")</td></tr>
                <tr><td><b>کل وزن (کلو)</b></td><td class="ltr-inline"><b>@_kachi.NetWeightKg.ToString("N2")</b></td></tr>
                <tr><td>ریٹ فی مَن</td><td class="ltr-inline">@(_kachi.RatePerUnit?.ToString("N2") ?? "طے نہیں")</td></tr>
            </table>
            <hr />
            <table style="width:100%;">
                @foreach (var line in _kachi.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Farmer))
                {
                    <tr><td>@line.NameUrdu</td><td class="ltr-inline">@line.Amount.ToString("N2")</td></tr>
                }
                <tr><td><b>مجموعی کٹوتی</b></td><td class="ltr-inline"><b>@_kachi.TotalDeductions.ToString("N2")</b></td></tr>
                <tr><td><b>کل رقم (کسان)</b></td><td class="ltr-inline"><b>@_kachi.Total.ToString("N2")</b></td></tr>
            </table>
            @if (_kachi.DeductionLines.Any(l => l.ChargedTo == DeductionChargedTo.Buyer))
            {
                <hr />
                <table style="width:100%;">
                    <tr><td colspan="2"><b>خریدار کے ذمہ</b></td></tr>
                    @foreach (var line in _kachi.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Buyer))
                    {
                        <tr><td>@line.NameUrdu</td><td class="ltr-inline">@line.Amount.ToString("N2")</td></tr>
                    }
                    <tr><td><b>کل (خریدار)</b></td><td class="ltr-inline"><b>@_kachi.BuyerChargesTotal.ToString("N2")</b></td></tr>
                </table>
            }
        </div>
    }
</RequireAuth>

@code {
    [Parameter] public int Id { get; set; }
    private KachiDto? _kachi;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { _kachi = await Api.GetKachiAsync(Id); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
}
