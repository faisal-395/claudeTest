@page "/print/multi-sale"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn" @onclick="PrintAsync">Print</button>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_pakkis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="no-print" style="background:#eaf7ee;border:1px solid #b6e3c2;padding:10px 14px;margin-bottom:14px;">
            Each row below is its own Pakki. <a href="pakki-records">View / edit all Pakki records</a>.
        </div>

        <div class="print-a4 rtl-urdu" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="text-align:center;font-size:1.3rem;font-weight:700;">عمر فاروق اینڈ برادرز</div>
            <div style="text-align:center;">پکی رسید — کئی کسان</div>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>خریدار: @(_pakkis[0].BuyerName ?? "—")</td>
                    <td>تاریخ: <span class="ltr-inline">@_pakkis[0].Date.ToString("yyyy-MM-dd")</span></td>
                </tr>
            </table>
            <hr />
            <table class="data-grid multi-print-grid" style="width:100%;">
                <thead>
                    <tr>
                        <th class="rtl-urdu">کسان</th>
                        <th class="rtl-urdu">جنس</th>
                        <th class="rtl-urdu">صافی وزن</th>
                        <th class="rtl-urdu">بوری</th>
                        <th class="rtl-urdu">ریٹ</th>
                        <th class="rtl-urdu">مجموعی رقم</th>
                        <th class="rtl-urdu">کٹوتی کی تفصیل</th>
                        <th class="rtl-urdu">کل کٹوتی</th>
                        <th class="rtl-urdu">کسان کو ادائیگی</th>
                        <th class="rtl-urdu">خریدار کٹوتی کی تفصیل</th>
                        <th class="rtl-urdu">خریدار چارجز</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _pakkis)
                    {
                        <tr>
                            <td>@p.FarmerName</td>
                            <td>@p.ProductName</td>
                            <td><span class="ltr-inline">@p.NetWeightKg.ToString("N2")</span></td>
                            <td><span class="ltr-inline">@(p.BoriQty?.ToString("N2") ?? "-")</span></td>
                            <td><span class="ltr-inline">@p.RatePerUnit.ToString("N2")</span></td>
                            <td><span class="ltr-inline">@p.GrossAmount.ToString("N2")</span></td>
                            <td>
                                @foreach (var line in p.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Seller))
                                {
                                    <div>@line.NameUrdu: <span class="ltr-inline">@line.Amount.ToString("N2")</span></div>
                                }
                            </td>
                            <td><span class="ltr-inline"><b>@p.TotalDeductions.ToString("N2")</b></span></td>
                            <td><span class="ltr-inline"><b>@p.NetPayableToFarmer.ToString("N2")</b></span></td>
                            <td>
                                @foreach (var line in p.DeductionLines.Where(l => l.ChargedTo == DeductionChargedTo.Buyer))
                                {
                                    <div>@line.NameUrdu: <span class="ltr-inline">@line.Amount.ToString("N2")</span></div>
                                }
                            </td>
                            <td><span class="ltr-inline">@(p.BuyerChargesTotal > 0 ? p.BuyerChargesTotal.ToString("N2") : "-")</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2"><b class="rtl-urdu">کل</b></td>
                        <td><span class="ltr-inline"><b>@_pakkis.Sum(p => p.NetWeightKg).ToString("N2")</b></span></td>
                        <td></td>
                        <td></td>
                        <td><span class="ltr-inline"><b>@_pakkis.Sum(p => p.GrossAmount).ToString("N2")</b></span></td>
                        <td></td>
                        <td><span class="ltr-inline"><b>@_pakkis.Sum(p => p.TotalDeductions).ToString("N2")</b></span></td>
                        <td><span class="ltr-inline"><b>@_pakkis.Sum(p => p.NetPayableToFarmer).ToString("N2")</b></span></td>
                        <td></td>
                        <td><span class="ltr-inline"><b>@_pakkis.Sum(p => p.BuyerChargesTotal).ToString("N2")</b></span></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery] public string? Ids { get; set; }

    private List<PakkiDto>? _pakkis;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var ids = (Ids ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => int.TryParse(s, out var id) ? id : (int?)null)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToList();

        if (ids.Count == 0)
        {
            _error = "No receipts to show — this page expects one or more Pakki ids in the URL.";
            return;
        }

        try
        {
            var pakkis = new List<PakkiDto>();
            foreach (var id in ids)
            {
                pakkis.Add(await Api.GetPakkiAsync(id));
            }
            _pakkis = pakkis;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
}
