@page "/print/purchase/{Id:int}"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div class="no-print" style="margin-bottom:12px;">
        <button class="btn secondary" @onclick="GoBackAsync">← Back</button>
        <button class="btn" @onclick="PrintAsync">Print</button>
        @if (_purchase is { IsCancelled: false })
        {
            <button class="btn danger" @onclick="CancelAsync">Cancel Purchase</button>
        }
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_purchase is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="print-a4" style="background:white;padding:20px;border:1px solid #ccc;">
            <div style="border:1px solid #000;padding:8px 10px;">
                <div style="text-align:center;font-family:Georgia,'Times New Roman',serif;font-size:1.3rem;font-weight:700;">@_companyInfo?.NameEnglish</div>
                @if (!string.IsNullOrWhiteSpace(_companyInfo?.MarketName))
                {
                    <div style="text-align:center;font-size:0.9rem;">@_companyInfo.MarketName</div>
                }
                @if (ContactLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.75rem;">@ContactLine</div>
                }
                @if (ProprietorLine is { Length: > 0 })
                {
                    <div style="text-align:center;font-size:0.8rem;">@ProprietorLine</div>
                }
            </div>
            <div style="text-align:center;color:#666;margin-top:6px;">Purchase Invoice</div>
            <hr />
            <table style="width:100%;">
                <tr>
                    <td>Invoice #: <b>@_purchase.InvoiceNo</b></td>
                    <td style="text-align:right;">Date: <b>@_purchase.Date.ToString("yyyy-MM-dd")</b></td>
                </tr>
                @if (_purchase.BillNo is { Length: > 0 })
                {
                    <tr>
                        <td colspan="2">Bill #: <b>@_purchase.BillNo</b></td>
                    </tr>
                }
                <tr>
                    <td>Supplier: <b>@_purchase.SupplierName</b></td>
                    <td style="text-align:right;">Status: <b>@(_purchase.IsCancelled ? "Cancelled" : "Open")</b></td>
                </tr>
                @if (_purchase.Description is { Length: > 0 })
                {
                    <tr>
                        <td colspan="2">Description: @_purchase.Description</td>
                    </tr>
                }
            </table>
            <hr />
            <table class="data-grid" style="width:100%;">
                <thead>
                    <tr><th>Product</th><th style="text-align:right;">Qty</th><th style="text-align:right;">Price</th><th style="text-align:right;">Discount %</th><th style="text-align:right;">Net</th><th>Expiry</th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _purchase.Lines)
                    {
                        <tr>
                            <td>@line.ProductName</td>
                            <td style="text-align:right;">@line.Quantity.ToString("N2")</td>
                            <td style="text-align:right;">@line.Price.ToString("N2")</td>
                            <td style="text-align:right;">@line.DiscountPercent.ToString("N2")%</td>
                            <td style="text-align:right;">@line.NetPrice.ToString("N2")</td>
                            <td>@(line.ExpiryDate is { } ed ? ed.ToString("yyyy-MM-dd") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <hr />
            <table style="width:100%;">
                <tr><td>Total Bill</td><td style="text-align:right;">@_purchase.TotalBill.ToString("N2")</td></tr>
                <tr><td>Total Discount</td><td style="text-align:right;">@_purchase.TotalDiscount.ToString("N2")</td></tr>
                <tr><td><b>Net Bill</b></td><td style="text-align:right;"><b>@_purchase.NetBill.ToString("N2")</b></td></tr>
                <tr><td>Paid Cash</td><td style="text-align:right;">@_purchase.PaidCash.ToString("N2")</td></tr>
            </table>
        </div>
    }
</RequireAuth>

@code {
    [Parameter] public int Id { get; set; }
    private PurchaseDto? _purchase;
    private CompanyInfoDto? _companyInfo;
    private string? _error;

    private string ContactLine => string.Join("  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.Phone) ? null : $"Phone: {_companyInfo.Phone}",
        string.IsNullOrWhiteSpace(_companyInfo?.Mobile) ? null : $"Mobile: {_companyInfo.Mobile}",
        string.IsNullOrWhiteSpace(_companyInfo?.Email) ? null : $"Email: {_companyInfo.Email}"
    }.Where(s => s is not null));

    private string ProprietorLine => string.Join("  |  ", new[]
    {
        string.IsNullOrWhiteSpace(_companyInfo?.ProprietorName) ? null : $"Proprietor: {_companyInfo.ProprietorName}",
        string.IsNullOrWhiteSpace(_companyInfo?.NtnNumber) ? null : $"NTN No: {_companyInfo.NtnNumber}"
    }.Where(s => s is not null));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _purchase = await Api.GetPurchaseAsync(Id);
            _companyInfo = await Api.GetCompanyInfoAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task CancelAsync()
    {
        _error = null;
        try
        {
            await Api.CancelPurchaseAsync(Id);
            _purchase = await Api.GetPurchaseAsync(Id);
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();

    // Uses real browser history instead of a hardcoded route — this page is reachable from the
    // combined Records Report, and "Back" should return there.
    private Task GoBackAsync() => JS.InvokeVoidAsync("history.back").AsTask();
}
