@page "/login"
@inject ApiClient Api
@inject AuthState AuthState
@inject NavigationManager Nav
@inject AppSettings AppSettings

<div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#f0f4f0;">
    <div style="background:white;padding:32px 36px;box-shadow:0 2px 8px rgba(0,0,0,0.15);width:340px;">
        <h2 style="color:#1B4332;margin-top:0;">Umer Farooq &amp; Brothers</h2>
        <p style="color:#666;margin-top:-8px;">Grain Market Management System</p>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <div style="margin-bottom:12px;">
                <label>Username</label>
                <input class="form-control" style="width:100%;padding:8px;box-sizing:border-box;" @bind="_model.Username" />
            </div>
            <div style="margin-bottom:16px;">
                <label>Password</label>
                <input type="password" class="form-control" style="width:100%;padding:8px;box-sizing:border-box;" @bind="_model.Password" />
            </div>
            <button type="submit" class="btn" style="width:100%;" disabled="@_busy">@(_busy ? "Signing in…" : "Sign In")</button>
        </EditForm>

        <div style="text-align:center;margin-top:14px;">
            <a href="settings" style="font-size:0.85rem;color:#777;">Connection settings</a>
        </div>
    </div>
</div>

@code {
    private readonly LoginFormModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var login = await Api.LoginAsync(new LoginRequest(_model.Username, _model.Password));

            var roles = await Api.GetRolesAsync();
            var role = roles.FirstOrDefault(r => r.Name == login.RoleName);

            AuthState.SetSession(login, role?.Permissions ?? new());
            await AuthState.PersistTokenAsync();

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Models.ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            // Surface the real cause (connection refused vs. TLS trust failure vs. timeout, etc.)
            // instead of one generic message — those need different fixes and otherwise look
            // identical to whoever's troubleshooting.
            var root = ex;
            while (root.InnerException is not null) root = root.InnerException;
            _error = $"Could not reach the server at {AppSettings.ApiBaseUrl} — [{root.GetType().Name}] {root.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class LoginFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
