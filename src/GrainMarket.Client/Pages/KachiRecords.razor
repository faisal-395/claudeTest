@page "/kachi-records"
@using GrainMarket.Application.Common.Services
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Kachi Records <span class="rtl-urdu" style="font-size:1rem;">کچی ریکارڈ</span></h1>
    <p style="color:#777;">Every Kachi raised from the Kachi entry screen — edit or view/print details here.</p>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    @if (_editingId is not null)
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Receipt Number / رسید نمبر</label><div style="padding:6px 0;">@(_receiptNumber ?? "—")</div></div>
            <div><label>Bill Number / بل نمبر</label><input @bind="_billNumber" placeholder="Bill #" /></div>
            <div><label>Date / تاریخ</label><DatePicker @bind-Value="_date" /></div>
            <div>
                <label>Season / سیزن</label>
                <SearchSelect TItem="SeasonDto" Items="_seasons" IdSelector="@(s => s.Id)" TextSelector="@(s => s.Name)" @bind-Value="_seasonId" Placeholder="Search season…" />
            </div>
            <div>
                <label>Farmer / کسان</label>
                <SearchSelect TItem="PartyDto" Items="_farmers" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" @bind-Value="_farmerId" Placeholder="Search farmer…" />
            </div>
            <div>
                <label>Product / جنس</label>
                <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_productId" Placeholder="Search product…" />
            </div>
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
            </div>
            <div><label>Bharti (kg/bag) / بھرتی</label><input type="number" step="0.01" @bind="_bhartiKgPerBag" /></div>
            <div><label>Total Weight (kg) / کل وزن</label><input type="number" step="0.01" @bind="_totalWeightKg" /></div>
            <div>
                <label>Man / Dhrn / Kg &nbsp;<span class="rtl-urdu">من / دھرن / کلو</span></label>
                <div class="rtl-urdu" style="padding:6px 0;">
                    @if (EditBreakdown is not null)
                    {
                        <span>من: <b>@EditBreakdown.Value.ManCount</b></span>
                        <span>&nbsp;&nbsp;دھرن: <b>@EditBreakdown.Value.DhrnCount</b></span>
                        <span>&nbsp;&nbsp;کلو: <b>@EditBreakdown.Value.KgRemainder.ToString("N2")</b></span>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </div>
            </div>
            <div><label>Rate per Man (Darr) / ریٹ فی مَن (دَر)</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number / گاڑی نمبر (for freight)</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                @if (!CanSave)
                {
                    <div class="invalid-total">Enter Bharti, Total Weight and a rate greater than zero before saving.</div>
                }
                <button class="btn" disabled="@(!CanSave)" @onclick="SaveAsync">Update Kachi</button>
                <button class="btn secondary" @onclick="ResetForm">Cancel Edit</button>
            </div>
        </div>
    }

    @if (_kachis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="data-grid kachi-records-grid">
            <thead><tr><th>Invoice</th><th>Date</th><th>Farmer / کسان</th><th>Buyer / خریدار</th><th>Product / جنس</th><th>Weight</th><th>Rate/Man</th><th>Total</th><th></th></tr></thead>
            <tbody>
                @foreach (var k in _kachis)
                {
                    <tr>
                        <td>@k.InvoiceNo</td>
                        <td>@k.Date.ToString("yyyy-MM-dd")</td>
                        <td>@k.FarmerName</td>
                        <td>@(k.BuyerName ?? "—")</td>
                        <td>@k.ProductName</td>
                        <td>@(k.BoriQty?.ToString("N2") ?? "—") Bori (@k.NetWeightKg.ToString("N2") kg)</td>
                        <td>@(k.RatePerUnit?.ToString("N2") ?? "—")</td>
                        <td>@k.Total.ToString("N2")</td>
                        <td>
                            <a href="print/kachi/@k.Id">Details</a>
                            @if (k.Status == InvoiceStatus.Open)
                            {
                                <text> | </text>
                                <a href="#" @onclick="() => Edit(k)" @onclick:preventDefault="true">Edit</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    private List<KachiDto>? _kachis;
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private List<UnitConversion>? _unitConversionEntities;
    private string? _error;
    private int? _editingId;

    private string? _receiptNumber;
    private string? _billNumber;
    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _farmerId;
    private int _buyerId;
    private int _productId;
    private decimal? _bhartiKgPerBag;
    private decimal? _totalWeightKg;
    private decimal? _rate;
    private string? _vehicleNumber;

    private bool CanSave =>
        _buyerId > 0 && (_bhartiKgPerBag ?? 0) > 0 && (_rate ?? 0) > 0 && (_totalWeightKg ?? 0) > 0;

    private (int ManCount, int DhrnCount, decimal KgRemainder)? EditBreakdown
    {
        get
        {
            if (_unitConversionEntities is null || _totalWeightKg is not > 0) return null;
            try
            {
                return UnitConversionCalculator.BreakdownIntoManDhrnKg(_totalWeightKg.Value, _productId, _unitConversionEntities);
            }
            catch (Application.Common.Exceptions.InvalidCalculationException) { return null; }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Buyer);
            _products = await Api.GetProductsAsync();

            var conversions = await Api.GetUnitConversionsAsync();
            _unitConversionEntities = conversions.Select(c => new UnitConversion
            {
                Id = c.Id, Unit = c.Unit, FactorToKg = c.FactorToKg, ProductId = c.ProductId, IsActive = c.IsActive
            }).ToList();
        }
        catch (Models.ApiException ex) { _error = ex.Message; return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _kachis = await Api.GetKachisAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void Edit(KachiDto k)
    {
        _editingId = k.Id;
        _receiptNumber = k.ReceiptNumber;
        _billNumber = k.BillNumber;
        _date = k.Date;
        _seasonId = k.SeasonId;
        _farmerId = k.FarmerId;
        _buyerId = k.BuyerId ?? 0;
        _productId = k.ProductId;
        _bhartiKgPerBag = k.BhartiKgPerBag;
        _totalWeightKg = k.TotalWeightKg;
        _rate = k.RatePerUnit;
        _vehicleNumber = k.DeductionLines.FirstOrDefault(l => l.VehicleNumber is not null)?.VehicleNumber;
    }

    private void ResetForm()
    {
        _editingId = null;
        _receiptNumber = null;
        _billNumber = null;
        _date = DateTime.Today;
        _buyerId = 0;
        _bhartiKgPerBag = null; _totalWeightKg = null; _rate = null; _vehicleNumber = null;
    }

    private async Task SaveAsync()
    {
        if (_editingId is null) return;
        _error = null;
        try
        {
            var request = new UpdateKachiRequest(_date, _seasonId, _farmerId, _buyerId, _productId, _bhartiKgPerBag, _totalWeightKg, _rate, _vehicleNumber, null, _billNumber);
            await Api.UpdateKachiAsync(_editingId.Value, request);
            ResetForm();
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
