@page "/kachi"
@using GrainMarket.Application.Common
@using GrainMarket.Application.Common.Exceptions
@using GrainMarket.Application.Common.Services
@using GrainMarket.Application.MultiPurchase
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <h1 class="page-title" style="margin-bottom:4px;">Kachi <span class="rtl-urdu" style="font-size:1rem;">کچی رسید</span></h1>
        <a href="kachi-records">View Kachi Records</a>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_successMessage is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
    }

    <div class="form-grid" style="max-width:1100px;margin-bottom:12px;grid-template-columns:140px 1fr 1fr;">
        <div><label>Bill Number / بل نمبر</label><input @bind="_billNumber" placeholder="Bill #" /></div>
        <div><label>Date / تاریخ</label><DatePicker @bind-Value="_date" /></div>
        <div>
            <label>Season / سیزن</label>
            <SearchSelect TItem="SeasonDto" Items="_seasons" IdSelector="@(s => s.Id)" TextSelector="@(s => s.Name)" @bind-Value="_seasonId" Placeholder="Search season…" />
        </div>
    </div>
    <div class="form-grid" style="max-width:1100px;margin-bottom:12px;">
        <div>
            <label>Buyer / خریدار</label>
            <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
        </div>
        <div>
            <label>Product / جنس</label>
            <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_productId" Placeholder="Search product…" />
        </div>
    </div>

    @if (KachiRules.Count > 0)
    {
        <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:0.85rem;color:#444;background:#f7f9f7;border:1px solid #e2e2e2;border-radius:4px;padding:6px 12px;margin-bottom:10px;">
            <span style="font-weight:600;">Kachi Tax / Deductions:</span>
            @foreach (var r in KachiRules)
            {
                <span>
                    @r.Name (@r.ChargedTo): @RatePrefix(r)<input type="number" step="0.01" style="width:60px;" value="@GetEffectiveRate(r)" @onchange="@(e => SetRateOverride(r.Id, e.Value))" />@RateSuffix(r)
                </span>
            }
        </div>
    }

    <table class="data-grid multi-purchase-grid">
        <thead>
            <tr>
                <th style="width:24px;"></th>
                <th style="min-width:150px;" class="rtl-urdu">کسان</th>
                <th class="rtl-urdu">بھرتی</th><th class="rtl-urdu">کل وزن (کلو)</th>
                <th class="rtl-urdu">ریٹ فی مَن (دَر)</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < _rows.Count; i++)
            {
                var index = i;
                var row = _rows[index];
                var calc = Calculate(row);
                <tr class="@(_selectedIndex == index ? "selected-row" : "")">
                    <td style="text-align:center;"><input type="radio" name="rowSelect" checked="@(_selectedIndex == index)" @onchange="() => _selectedIndex = index" /></td>
                    <td><SearchSelect TItem="PartyDto" Items="_farmers" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" Value="@row.FarmerId" ValueChanged="@(v => row.FarmerId = v)" Placeholder="Farmer…" /></td>
                    <td><input type="number" step="0.01" style="width:80px;" @bind="row.BhartiKgPerBag" /></td>
                    <td><input type="number" step="0.01" style="width:90px;" @bind="row.TotalWeightKg" /></td>
                    <td><input type="number" step="0.01" style="width:80px;" @bind="row.RatePerUnit" /></td>
                </tr>
                <tr>
                    <td colspan="5" style="background:#f7f9f7;padding:3px 10px;font-size:0.8rem;color:#444;">
                        @if (calc is not null)
                        {
                            <div class="rtl-urdu">
                                @if (calc.Breakdown is not null)
                                {
                                    <span>من: <b>@calc.Breakdown.Value.ManCount</b></span>
                                    <span>&nbsp;&nbsp;دھرن: <b>@calc.Breakdown.Value.DhrnCount</b></span>
                                    <span>&nbsp;&nbsp;کلو: <b>@calc.Breakdown.Value.KgRemainder.ToString("N2")</b></span>
                                }
                                else
                                {
                                    <span style="color:#999;">—</span>
                                }
                                <span>&nbsp;·&nbsp;صافی وزن: <b>@calc.NetWeightKg.ToString("N2")</b> کلو</span>
                                @if (calc.BoriQty is not null)
                                {
                                    <span>&nbsp;·&nbsp;بوری: <b>@calc.BoriQty.Value.ToString("N2")</b></span>
                                }
                                <span>&nbsp;·&nbsp;مجموعی رقم: <b>@calc.GrossAmount.ToString("N2")</b></span>
                                @if (calc.FarmerLines.Count > 0 || calc.BuyerLines.Count > 0)
                                {
                                    <span>&nbsp;·&nbsp;@string.Join("، ", calc.FarmerLines.Concat(calc.BuyerLines).Select(l => $"{l.NameUrdu} {l.Amount:N2}"))</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span style="color:#999;">Enter Bharti, Total Weight and a rate to see the calculation</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="total-figure rtl-urdu" style="margin-top:12px;display:flex;gap:28px;flex-wrap:wrap;">
        <span>مجموعی رقم (کل): Rs @GrandGross.ToString("N2")</span>
        <span>مجموعی کٹوتی (کل): Rs @GrandDeductions.ToString("N2")</span>
        <span>مجموعی کل رقم (کسان): Rs @GrandTotal.ToString("N2")</span>
        @if (GrandBuyerCharges > 0)
        {
            <span>مجموعی خریدار چارجز: Rs @GrandBuyerCharges.ToString("N2")</span>
        }
    </div>
    <div style="margin-top:8px;">
        <button class="btn secondary" @onclick="AddRow">Add</button>
        <button class="btn danger" disabled="@(_selectedIndex is null)" @onclick="RemoveSelectedRow">Remove</button>
        <button class="btn" disabled="@(!CanSave || _saving)" @onclick="() => SaveAsync(andPrint: false)">@(_saving ? "Saving…" : "Save")</button>
        <button class="btn" disabled="@(!CanSave || _saving)" @onclick="() => SaveAsync(andPrint: true)">@(_saving ? "Saving…" : "Save & Print")</button>
    </div>
</RequireAuth>

@code {
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private List<DeductionRule>? _deductionRuleEntities;
    private List<UnitConversion>? _unitConversionEntities;
    private string? _error;
    private string? _successMessage;
    private bool _saving;

    private string? _billNumber;
    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _buyerId;
    private int _productId;
    private int? _selectedIndex;
    private readonly List<RowModel> _rows = new();

    /// <summary>Operator-entered rate overrides for this batch only (e.g. less Commission than the
    /// standard Setup > Format rate) — keyed by DeductionRuleId, applied identically to every row
    /// when saving. Never changes the underlying DeductionRule.</summary>
    private readonly Dictionary<int, decimal> _rateOverrides = new();

    private decimal GrandGross => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.GrossAmount);
    private decimal GrandDeductions => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.FarmerDeductionsTotal);
    private decimal GrandBuyerCharges => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.BuyerChargesTotal);
    private decimal GrandTotal => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.Total);

    /// <summary>Active deduction rules that apply at the Kachi stage — drives the summary box shown
    /// beside "View Kachi Records" so the operator can see current tax/deduction rates at a glance.</summary>
    private List<DeductionRule> KachiRules =>
        (_deductionRuleEntities ?? new())
            .Where(r => r.IsActive && (r.AppliesTo == DeductionAppliesTo.Kachi || r.AppliesTo == DeductionAppliesTo.Both))
            .OrderBy(r => r.SortOrder)
            .ToList();

    private decimal GetEffectiveRate(DeductionRule r) => _rateOverrides.TryGetValue(r.Id, out var v) ? v : r.Value;

    private static string RatePrefix(DeductionRule r) => r.CalculationType == DeductionCalculationType.PercentOfGross ? "" : "Rs ";
    private static string RateSuffix(DeductionRule r) => r.CalculationType switch
    {
        DeductionCalculationType.PercentOfGross => "%",
        DeductionCalculationType.PerUnitWeight => "/kg",
        _ => ""
    };

    private bool CanSave =>
        _buyerId > 0 && _productId > 0 && _rows.Count > 0 &&
        _rows.All(r => r.FarmerId > 0 && (r.RatePerUnit ?? 0) > 0 &&
                        (r.BhartiKgPerBag ?? 0) > 0 && (r.TotalWeightKg ?? 0) > 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Vendor);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_buyers.Count > 0) _buyerId = _buyers[0].Id;
            if (_products.Count > 0) _productId = _products[0].Id;

            var rules = await Api.GetDeductionRulesAsync();
            _deductionRuleEntities = rules.Select(r => new DeductionRule
            {
                Id = r.Id, Name = r.Name, NameUrdu = r.NameUrdu, CalculationType = r.CalculationType, Value = r.Value,
                AppliesTo = r.AppliesTo, ChargedTo = r.ChargedTo, SortOrder = r.SortOrder, IsActive = r.IsActive,
                ProductId = r.ProductId, PartyId = r.PartyId, RequiresVehicleNumber = r.RequiresVehicleNumber,
                IncomeAccountId = r.IncomeAccountId
            }).ToList();

            var conversions = await Api.GetUnitConversionsAsync();
            _unitConversionEntities = conversions.Select(c => new UnitConversion
            {
                Id = c.Id, Unit = c.Unit, FactorToKg = c.FactorToKg, ProductId = c.ProductId, IsActive = c.IsActive
            }).ToList();

            AddRow();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void AddRow() => _rows.Add(new RowModel
    {
        FarmerId = _farmers?.FirstOrDefault()?.Id ?? 0
    });

    private void RemoveSelectedRow()
    {
        if (_selectedIndex is null || _selectedIndex >= _rows.Count) return;
        _rows.RemoveAt(_selectedIndex.Value);
        _selectedIndex = null;
    }

    /// <summary>Lets the operator charge less (or more) than the standard Setup > Format rate for
    /// one deduction rule, for this whole batch — e.g. less Commission this time.</summary>
    private void SetRateOverride(int deductionRuleId, object? value)
    {
        if (decimal.TryParse(value?.ToString(), out var rate) && rate >= 0)
        {
            _rateOverrides[deductionRuleId] = rate;
        }
    }

    /// <summary>Drives both the per-row calculation line and the grand-total summary — reuses the
    /// exact same DeductionEngine/UnitConversionCalculator the server's KachiService uses to post
    /// the Kachi (AppliesTo.Kachi, matching the Kachi-stage deduction rules, not Pakki's), so what's
    /// shown always matches what actually gets charged rather than being a second, hand-written copy
    /// of the math that could drift from it. Returns null while the row has no weight/rate yet or
    /// the product's conversion factor isn't configured.</summary>
    private RowCalculation? Calculate(RowModel row)
    {
        if (_deductionRuleEntities is null || _unitConversionEntities is null || row.RatePerUnit is not > 0
            || row.TotalWeightKg is not > 0) return null;

        try
        {
            var netWeightKg = row.TotalWeightKg.Value;

            var boriFactor = UnitConversionCalculator.FactorFor(WeightUnit.Bori, _productId, _unitConversionEntities);
            var boriQty = netWeightKg / boriFactor;

            // Man/Dhrn/Kg is a display-only breakdown — if Dhrn's conversion factor isn't
            // configured yet (Setup > Unit Conversions), that must not blank out the whole row's
            // Gross/Deductions/Total below it, only this one figure.
            (int ManCount, int DhrnCount, decimal KgRemainder)? breakdown = null;
            try
            {
                breakdown = UnitConversionCalculator.BreakdownIntoManDhrnKg(netWeightKg, _productId, _unitConversionEntities);
            }
            catch (InvalidCalculationException) { }

            var gross = UnitConversionCalculator.GrossAmountFromRatePerMan(row.RatePerUnit.Value, netWeightKg, _productId, _unitConversionEntities);
            var deductions = DeductionEngine.Calculate(gross, netWeightKg, DeductionAppliesTo.Kachi, _productId, row.FarmerId, _deductionRuleEntities, _rateOverrides);
            var farmerLines = deductions.Lines.Where(l => l.ChargedTo == DeductionChargedTo.Seller).ToList();
            var buyerLines = deductions.Lines.Where(l => l.ChargedTo == DeductionChargedTo.Buyer).ToList();
            var farmerTotal = farmerLines.Sum(l => l.Amount);
            var buyerTotal = buyerLines.Sum(l => l.Amount);
            return new RowCalculation(netWeightKg, boriQty, breakdown, gross, farmerLines, buyerLines, farmerTotal, buyerTotal, gross - farmerTotal);
        }
        catch (InvalidCalculationException)
        {
            return null;
        }
    }

    private async Task SaveAsync(bool andPrint)
    {
        _error = null;
        _successMessage = null;
        _saving = true;
        try
        {
            var overrides = _rateOverrides.Select(o => new DeductionOverrideRequest(o.Key, o.Value)).ToList();
            var request = new CreateMultiPurchaseRequest(_date, _seasonId, _buyerId,
                _rows.Select(r => new MultiPurchaseRowRequest(r.FarmerId, _productId, r.BhartiKgPerBag, r.TotalWeightKg, r.RatePerUnit, r.VehicleNumber, r.Notes, overrides)).ToList(),
                _billNumber);

            var result = await Api.CreateMultiPurchaseAsync(request);

            if (andPrint)
            {
                var ids = string.Join(",", result.Rows.Select(r => r.KachiId));
                Nav.NavigateTo($"/print/multi-purchase?ids={ids}");
                return;
            }

            _successMessage = $"Saved {result.Rows.Count} Kachi record(s) for {result.BuyerName}.";
            _billNumber = null;
            _rateOverrides.Clear();
            _rows.Clear();
            _selectedIndex = null;
            AddRow();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private class RowModel
    {
        public int FarmerId { get; set; }
        public decimal? BhartiKgPerBag { get; set; }
        public decimal? TotalWeightKg { get; set; }
        public decimal? RatePerUnit { get; set; }
        public string? VehicleNumber { get; set; }
        public string? Notes { get; set; }
    }

    private record RowCalculation(
        decimal NetWeightKg, decimal? BoriQty, (int ManCount, int DhrnCount, decimal KgRemainder)? Breakdown, decimal GrossAmount,
        List<DeductionLineResult> FarmerLines, List<DeductionLineResult> BuyerLines,
        decimal FarmerDeductionsTotal, decimal BuyerChargesTotal, decimal Total);
}
