@page "/pakki"
@using GrainMarket.Application.Common
@using GrainMarket.Application.Common.Exceptions
@using GrainMarket.Application.Common.Services
@using GrainMarket.Application.MultiSale
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <h1 class="page-title" style="margin-bottom:4px;">Pakki <span class="rtl-urdu" style="font-size:1rem;">پکی رسید</span></h1>
        <a href="pakki-records">View Pakki Records</a>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_successMessage is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
    }

    @if (FromKachi.HasValue && _sourceKachi is not null)
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Converting Kachi</label><input value="@_sourceKachi.InvoiceNo" disabled /></div>
            <div><label>Farmer / کسان</label><input value="@_sourceKachi.FarmerName" disabled /></div>
            <div><label>Product / جنس</label><input value="@_sourceKachi.ProductName" disabled /></div>
            <div><label>Net Weight (kg)</label><input value="@_sourceKachi.NetWeightKg.ToString("N2")" disabled /></div>
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_vendors" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_convertBuyerId" Placeholder="Search buyer…" />
            </div>
            <div><label>Rate per Man / ریٹ فی مَن</label><input type="number" step="0.01" @bind="_convertRate" /></div>
            <div><label>Vehicle Number / گاڑی نمبر</label><input @bind="_convertVehicleNumber" /></div>
            <div style="grid-column: span 2;">
                @if (_convertRate is null or <= 0)
                {
                    <div class="invalid-total">Enter a rate greater than zero before finalizing.</div>
                }
                <button class="btn" disabled="@(_convertRate is null or <= 0)" @onclick="ConvertAsync">Finalize Pakki</button>
            </div>
        </div>
    }
    else
    {
        <div class="form-grid" style="max-width:1100px;margin-bottom:12px;grid-template-columns:140px 1fr 1fr;">
            <div><label>Bill Number / بل نمبر</label><input @bind="_billNumber" placeholder="Bill #" /></div>
            <div><label>Date / تاریخ</label><DatePicker @bind-Value="_date" /></div>
            <div>
                <label>Season / سیزن</label>
                <SearchSelect TItem="SeasonDto" Items="_seasons" IdSelector="@(s => s.Id)" TextSelector="@(s => s.Name)" @bind-Value="_seasonId" Placeholder="Search season…" />
            </div>
        </div>
        <div class="form-grid" style="max-width:1100px;margin-bottom:12px;">
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_vendors" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
            </div>
            <div>
                <label>Product / جنس</label>
                <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_productId" Placeholder="Search product…" />
            </div>
        </div>

        @if (PakkiRules.Count > 0)
        {
            <div style="display:flex;align-items:center;gap:18px;flex-wrap:wrap;font-size:0.85rem;color:#444;background:#f7f9f7;border:1px solid #e2e2e2;border-radius:4px;padding:6px 12px;margin-bottom:10px;">
                <span style="font-weight:600;">Pakki Tax / Deductions:</span>
                @foreach (var r in PakkiRules)
                {
                    <span>@r.Name (@r.ChargedTo): <b>@FormatRuleValue(r)</b></span>
                }
            </div>
        }

        <table class="data-grid multi-purchase-grid">
            <thead>
                <tr>
                    <th style="width:24px;"></th>
                    <th style="min-width:150px;" class="rtl-urdu">فروخت کنندہ (بیچنے والا)</th>
                    <th class="rtl-urdu">بھرتی</th><th class="rtl-urdu">کل وزن (کلو)</th>
                    <th class="rtl-urdu">ریٹ فی مَن (دَر)</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < _rows.Count; i++)
                {
                    var index = i;
                    var row = _rows[index];
                    var calc = Calculate(row);
                    <tr class="@(_selectedIndex == index ? "selected-row" : "")">
                        <td style="text-align:center;"><input type="radio" name="rowSelect" checked="@(_selectedIndex == index)" @onchange="() => _selectedIndex = index" /></td>
                        <td><SearchSelect TItem="PartyDto" Items="@SellerChoices" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" Value="@row.FarmerId" ValueChanged="@(v => row.FarmerId = v)" Placeholder="Vendor…" /></td>
                        <td><input type="number" step="0.01" style="width:80px;" @bind="row.BhartiKgPerBag" /></td>
                        <td><input type="number" step="0.01" style="width:90px;" @bind="row.TotalWeightKg" /></td>
                        <td><input type="number" step="0.01" style="width:80px;" @bind="row.RatePerUnit" /></td>
                    </tr>
                    <tr>
                        <td colspan="5" style="background:#f7f9f7;padding:3px 10px;font-size:0.8rem;color:#444;">
                            @if (calc is not null)
                            {
                                <div class="rtl-urdu">
                                    <span>صافی وزن: <b>@calc.NetWeightKg.ToString("N2")</b> کلو</span>
                                    @if (calc.BoriQty is not null)
                                    {
                                        <span>&nbsp;·&nbsp;بوری: <b>@calc.BoriQty.Value.ToString("N2")</b></span>
                                    }
                                    <span>&nbsp;·&nbsp;مجموعی رقم: <b>@calc.GrossAmount.ToString("N2")</b></span>
                                    @if (calc.FarmerLines.Count > 0 || calc.BuyerLines.Count > 0)
                                    {
                                        <span>&nbsp;·&nbsp;@string.Join("، ", calc.FarmerLines.Concat(calc.BuyerLines).Select(l => $"{l.NameUrdu} {l.Amount:N2}"))</span>
                                    }
                                    <span>&nbsp;·&nbsp;کسان کو ادائیگی: <b>@calc.NetPayableToFarmer.ToString("N2")</b></span>
                                </div>
                            }
                            else
                            {
                                <span style="color:#999;">Enter weight and a rate to see the calculation</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-figure rtl-urdu" style="margin-top:12px;display:flex;gap:28px;flex-wrap:wrap;">
            <span>مجموعی رقم (کل): Rs @GrandGross.ToString("N2")</span>
            <span>مجموعی کٹوتی (کل): Rs @GrandDeductions.ToString("N2")</span>
            <span>مجموعی کل رقم (کسان): Rs @GrandTotal.ToString("N2")</span>
        </div>
        <div style="margin-top:8px;">
            <button class="btn secondary" @onclick="AddRow">Add</button>
            <button class="btn danger" disabled="@(_selectedIndex is null)" @onclick="RemoveSelectedRow">Remove</button>
            <button class="btn" disabled="@(!CanSave || _saving)" @onclick="() => SaveAsync(andPrint: false)">@(_saving ? "Saving…" : "Save")</button>
            <button class="btn" disabled="@(!CanSave || _saving)" @onclick="() => SaveAsync(andPrint: true)">@(_saving ? "Saving…" : "Save & Print")</button>
        </div>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery(Name = "fromKachi")]
    public int? FromKachi { get; set; }

    private KachiDto? _sourceKachi;
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _vendors;
    private List<ProductDto>? _products;
    private List<DeductionRule>? _deductionRuleEntities;
    private List<UnitConversion>? _unitConversionEntities;
    private string? _error;
    private string? _successMessage;
    private bool _saving;

    private string? _billNumber;
    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _buyerId;
    private int _productId;
    private int? _selectedIndex;
    private readonly List<RowModel> _rows = new();

    // From-Kachi conversion mode fields (single row, unrelated to the batch grid above).
    private int _convertBuyerId;
    private decimal? _convertRate;
    private string? _convertVehicleNumber;

    /// <summary>Pakki is vendor-to-vendor: a Vendor can't sell to itself in the same Pakki, so the
    /// grid's per-row seller list excludes whichever Vendor is picked as the top purchaser.</summary>
    private List<PartyDto> SellerChoices => (_vendors ?? new()).Where(v => v.Id != _buyerId).ToList();

    private decimal GrandGross => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.GrossAmount);
    private decimal GrandDeductions => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.TotalDeductions);
    private decimal GrandTotal => _rows.Select(Calculate).Where(c => c is not null).Sum(c => c!.NetPayableToFarmer);

    /// <summary>Active deduction rules that apply at the Pakki stage — drives the summary box shown
    /// beside "View Pakki Records" so the operator can see current tax/deduction rates at a glance.</summary>
    private List<DeductionRule> PakkiRules =>
        (_deductionRuleEntities ?? new())
            .Where(r => r.IsActive && (r.AppliesTo == DeductionAppliesTo.Pakki || r.AppliesTo == DeductionAppliesTo.Both))
            .OrderBy(r => r.SortOrder)
            .ToList();

    private static string FormatRuleValue(DeductionRule r) => r.CalculationType switch
    {
        DeductionCalculationType.PercentOfGross => $"{r.Value:N2}%",
        DeductionCalculationType.PerUnitWeight => $"Rs {r.Value:N2}/kg",
        _ => $"Rs {r.Value:N2}"
    };

    private bool CanSave =>
        _buyerId > 0 && _productId > 0 && _rows.Count > 0 &&
        _rows.All(r => r.FarmerId > 0 && (r.RatePerUnit ?? 0) > 0 &&
                        (r.BhartiKgPerBag ?? 0) > 0 && (r.TotalWeightKg ?? 0) > 0);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _vendors = await Api.GetPartiesAsync(PartyType.Vendor);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_vendors.Count > 0) { _buyerId = _vendors[0].Id; _convertBuyerId = _vendors[0].Id; }
            if (_products.Count > 0) _productId = _products[0].Id;

            var rules = await Api.GetDeductionRulesAsync();
            _deductionRuleEntities = rules.Select(r => new DeductionRule
            {
                Id = r.Id, Name = r.Name, NameUrdu = r.NameUrdu, CalculationType = r.CalculationType, Value = r.Value,
                AppliesTo = r.AppliesTo, ChargedTo = r.ChargedTo, SortOrder = r.SortOrder, IsActive = r.IsActive,
                ProductId = r.ProductId, PartyId = r.PartyId, RequiresVehicleNumber = r.RequiresVehicleNumber,
                IncomeAccountId = r.IncomeAccountId
            }).ToList();

            var conversions = await Api.GetUnitConversionsAsync();
            _unitConversionEntities = conversions.Select(c => new UnitConversion
            {
                Id = c.Id, Unit = c.Unit, FactorToKg = c.FactorToKg, ProductId = c.ProductId, IsActive = c.IsActive
            }).ToList();
        }
        catch (Models.ApiException ex) { _error = ex.Message; return; }

        if (FromKachi.HasValue)
        {
            try { _sourceKachi = await Api.GetKachiAsync(FromKachi.Value); }
            catch (Models.ApiException ex) { _error = ex.Message; }
        }
        else
        {
            AddRow();
        }
    }

    private void AddRow() => _rows.Add(new RowModel
    {
        FarmerId = SellerChoices.FirstOrDefault()?.Id ?? 0
    });

    private void RemoveSelectedRow()
    {
        if (_selectedIndex is null || _selectedIndex >= _rows.Count) return;
        _rows.RemoveAt(_selectedIndex.Value);
        _selectedIndex = null;
    }

    /// <summary>Drives both the per-row calculation line and the grand-total summary — reuses the
    /// exact same DeductionEngine/UnitConversionCalculator the server's PakkiService uses to post a
    /// standalone Pakki (AppliesTo.Pakki), and NetPayableToFarmer/TotalDeductions come straight from
    /// DeductionEngine's NetAmount/TotalDeductions exactly as PakkiService.CreateStandaloneAsync
    /// persists them, so what's shown always matches what actually gets charged.</summary>
    private RowCalculation? Calculate(RowModel row)
    {
        if (_deductionRuleEntities is null || _unitConversionEntities is null || row.RatePerUnit is not > 0
            || row.TotalWeightKg is not > 0) return null;

        try
        {
            var netWeightKg = row.TotalWeightKg.Value;
            var boriFactor = UnitConversionCalculator.FactorFor(WeightUnit.Bori, _productId, _unitConversionEntities);
            var boriQty = netWeightKg / boriFactor;

            var gross = UnitConversionCalculator.GrossAmountFromRatePerMan(row.RatePerUnit.Value, netWeightKg, _productId, _unitConversionEntities);
            var deductions = DeductionEngine.Calculate(gross, netWeightKg, DeductionAppliesTo.Pakki, _productId, row.FarmerId, _deductionRuleEntities);
            var farmerLines = deductions.Lines.Where(l => l.ChargedTo == DeductionChargedTo.Farmer).ToList();
            var buyerLines = deductions.Lines.Where(l => l.ChargedTo == DeductionChargedTo.Buyer).ToList();
            return new RowCalculation(netWeightKg, boriQty, gross, farmerLines, buyerLines, deductions.TotalDeductions, deductions.NetAmount);
        }
        catch (InvalidCalculationException)
        {
            return null;
        }
    }

    private async Task SaveAsync(bool andPrint)
    {
        _error = null;
        _successMessage = null;
        _saving = true;
        try
        {
            var request = new CreateMultiSaleRequest(_date, _seasonId, _buyerId,
                _rows.Select(r => new MultiSaleRowRequest(r.FarmerId, _productId, r.BhartiKgPerBag, r.TotalWeightKg, r.RatePerUnit, r.VehicleNumber, r.Notes)).ToList(),
                _billNumber);

            var result = await Api.CreateMultiSaleAsync(request);

            if (andPrint)
            {
                var ids = string.Join(",", result.Rows.Select(r => r.PakkiId));
                Nav.NavigateTo($"/print/multi-sale?ids={ids}");
                return;
            }

            _successMessage = $"Saved {result.Rows.Count} Pakki record(s) for {result.BuyerName}.";
            _billNumber = null;
            _rows.Clear();
            _selectedIndex = null;
            AddRow();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
        finally { _saving = false; }
    }

    private async Task ConvertAsync()
    {
        _error = null;
        try
        {
            await Api.CreatePakkiFromKachiAsync(new CreatePakkiFromKachiRequest(FromKachi!.Value, _date, _convertBuyerId, _convertRate!.Value, _convertVehicleNumber, null));
            Nav.NavigateTo("/pakki-records");
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private class RowModel
    {
        public int FarmerId { get; set; }
        public decimal? BhartiKgPerBag { get; set; }
        public decimal? TotalWeightKg { get; set; }
        public decimal? RatePerUnit { get; set; }
        public string? VehicleNumber { get; set; }
        public string? Notes { get; set; }
    }

    private record RowCalculation(
        decimal NetWeightKg, decimal? BoriQty, decimal GrossAmount,
        List<DeductionLineResult> FarmerLines, List<DeductionLineResult> BuyerLines,
        decimal TotalDeductions, decimal NetPayableToFarmer);
}
