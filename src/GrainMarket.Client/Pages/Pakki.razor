@page "/pakki"
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <h1 class="page-title">Pakki (Final Sale Invoice) <span class="rtl-urdu" style="font-size:1rem;">پکی رسید</span></h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    @if (_editingId is not null)
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div style="grid-column: span 2;"><b>Editing @_editingInvoiceNo</b> — buyer, rate, vehicle and notes only; weight is fixed once posted.</div>
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
            </div>
            <div><label>Rate per Man / ریٹ فی مَن</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number / گاڑی نمبر</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                @if (_rate is null or <= 0)
                {
                    <div class="invalid-total">Enter a rate greater than zero.</div>
                }
                <button class="btn" disabled="@(_rate is null or <= 0)" @onclick="SaveEditAsync">Update Pakki</button>
                <button class="btn secondary" @onclick="ResetForm">Cancel</button>
            </div>
        </div>
    }
    else if (FromKachi.HasValue && _sourceKachi is not null)
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Converting Kachi</label><input value="@_sourceKachi.InvoiceNo" disabled /></div>
            <div><label>Farmer / کسان</label><input value="@_sourceKachi.FarmerName" disabled /></div>
            <div><label>Product / جنس</label><input value="@_sourceKachi.ProductName" disabled /></div>
            <div><label>Net Weight (kg)</label><input value="@_sourceKachi.NetWeightKg.ToString("N2")" disabled /></div>
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
            </div>
            <div><label>Rate per Man / ریٹ فی مَن</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number / گاڑی نمبر</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                @if (_rate is null or <= 0)
                {
                    <div class="invalid-total">Enter a rate greater than zero before finalizing.</div>
                }
                <button class="btn" disabled="@(_rate is null or <= 0)" @onclick="ConvertAsync">Finalize Pakki</button>
            </div>
        </div>
    }
    else
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Date / تاریخ</label><input type="date" @bind="_date" /></div>
            <div>
                <label>Season / سیزن</label>
                <select @bind="_seasonId">
                    @if (_seasons is not null) { @foreach (var s in _seasons) { <option value="@s.Id">@s.Name</option> } }
                </select>
            </div>
            <div>
                <label>Farmer / کسان</label>
                <SearchSelect TItem="PartyDto" Items="_farmers" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" @bind-Value="_farmerId" Placeholder="Search farmer…" />
            </div>
            <div>
                <label>Buyer / خریدار</label>
                <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
            </div>
            <div>
                <label>Product / جنس</label>
                <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_productId" Placeholder="Search product…" />
            </div>
            <div><label>Man / مَن</label><input type="number" step="0.01" @bind="_man" /></div>
            <div><label>Kilo / کلو</label><input type="number" step="0.01" @bind="_kilo" /></div>
            <div><label>Gram / گرام</label><input type="number" step="1" @bind="_gram" /></div>
            <div><label>Bori / بوری</label><input type="number" step="0.01" @bind="_bori" /></div>
            <div><label>Rate per Man / ریٹ فی مَن</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number / گاڑی نمبر</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                <button class="btn" disabled="@(!CanCreateStandalone)" @onclick="CreateStandaloneAsync">Save Standalone Pakki</button>
            </div>
        </div>
    }

    @if (_pakkis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="data-grid">
            <thead><tr><th>Invoice</th><th>Date</th><th>Buyer / خریدار</th><th>Farmer / کسان</th><th>Product / جنس</th><th>Gross</th><th>Deductions</th><th>Net to Farmer</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _pakkis)
                {
                    <tr>
                        <td>@p.InvoiceNo</td>
                        <td>@p.Date.ToString("yyyy-MM-dd")</td>
                        <td>@p.BuyerName</td>
                        <td>@p.FarmerName</td>
                        <td>@p.ProductName</td>
                        <td>@p.GrossAmount.ToString("N2")</td>
                        <td>@p.TotalDeductions.ToString("N2")</td>
                        <td>@p.NetPayableToFarmer.ToString("N2")</td>
                        <td>@p.Status</td>
                        <td>
                            <a href="#" @onclick="() => ToggleDetails(p.Id)" @onclick:preventDefault="true">@(_expandedId == p.Id ? "Hide" : "Details")</a>
                            <text> | </text>
                            @if (p.Status == InvoiceStatus.Open)
                            {
                                <a href="#" @onclick="() => Edit(p)" @onclick:preventDefault="true">Edit</a>
                                <text> | </text>
                            }
                            <a href="print/pakki/@p.Id">Print</a>
                        </td>
                    </tr>
                    @if (_expandedId == p.Id)
                    {
                        <tr>
                            <td colspan="10" style="background:#f7f9f7;">
                                <table style="width:auto;min-width:280px;">
                                    <thead><tr><th style="text-align:left;padding:2px 12px 2px 0;">Deduction</th><th style="text-align:left;padding:2px 12px;">اردو</th><th style="text-align:right;padding:2px 0;">Amount</th></tr></thead>
                                    <tbody>
                                        @foreach (var line in p.DeductionLines)
                                        {
                                            <tr>
                                                <td style="padding:2px 12px 2px 0;">@line.Name</td>
                                                <td class="rtl-urdu" style="padding:2px 12px;font-size:1rem;">@line.NameUrdu</td>
                                                <td style="text-align:right;padding:2px 0;">@line.Amount.ToString("N2")</td>
                                            </tr>
                                        }
                                        <tr>
                                            <td colspan="2" style="padding:4px 12px 0 0;"><b>Total Deductions</b></td>
                                            <td style="text-align:right;padding:4px 0 0;"><b>@p.TotalDeductions.ToString("N2")</b></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery(Name = "fromKachi")]
    public int? FromKachi { get; set; }

    private KachiDto? _sourceKachi;
    private List<PakkiDto>? _pakkis;
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private string? _error;

    private int? _editingId;
    private string? _editingInvoiceNo;
    private int? _expandedId;

    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _farmerId;
    private int _buyerId;
    private int _productId;
    private decimal? _man, _kilo, _gram, _bori;
    private decimal? _rate;
    private string? _vehicleNumber;

    private bool CanCreateStandalone => (_man ?? 0) + (_kilo ?? 0) + (_gram ?? 0) + (_bori ?? 0) > 0 && (_rate ?? 0) > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Buyer);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_farmers.Count > 0) _farmerId = _farmers[0].Id;
            if (_buyers.Count > 0) _buyerId = _buyers[0].Id;
            if (_products.Count > 0) _productId = _products[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; return; }

        if (FromKachi.HasValue)
        {
            try { _sourceKachi = await Api.GetKachiAsync(FromKachi.Value); }
            catch (Models.ApiException ex) { _error = ex.Message; }
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _pakkis = await Api.GetPakkisAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task ConvertAsync()
    {
        _error = null;
        try
        {
            await Api.CreatePakkiFromKachiAsync(new CreatePakkiFromKachiRequest(FromKachi!.Value, _date, _buyerId, _rate!.Value, _vehicleNumber, null));
            Nav.NavigateTo("/pakki");
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task CreateStandaloneAsync()
    {
        _error = null;
        try
        {
            await Api.CreateStandalonePakkiAsync(new CreateStandalonePakkiRequest(_date, _seasonId, _buyerId, _farmerId, _productId, _man, _kilo, _gram, _bori, _rate!.Value, _vehicleNumber, null));
            _man = null; _kilo = null; _gram = null; _bori = null; _rate = null; _vehicleNumber = null;
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void ToggleDetails(int id) => _expandedId = _expandedId == id ? null : id;

    private void Edit(PakkiDto p)
    {
        _editingId = p.Id;
        _editingInvoiceNo = p.InvoiceNo;
        _buyerId = p.BuyerId;
        _rate = p.RatePerUnit;
        _vehicleNumber = p.VehicleNumber;
    }

    private void ResetForm()
    {
        _editingId = null;
        _editingInvoiceNo = null;
        _rate = null;
        _vehicleNumber = null;
    }

    private async Task SaveEditAsync()
    {
        _error = null;
        try
        {
            await Api.UpdatePakkiAsync(_editingId!.Value, new UpdatePakkiRequest(_buyerId, _rate!.Value, _vehicleNumber, null));
            ResetForm();
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
