@page "/pakki"
@inject ApiClient Api
@inject NavigationManager Nav

<RequireAuth>
    <h1 class="page-title">Pakki (Final Sale Invoice)</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    @if (FromKachi.HasValue && _sourceKachi is not null)
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Converting Kachi</label><input value="@_sourceKachi.InvoiceNo" disabled /></div>
            <div><label>Farmer</label><input value="@_sourceKachi.FarmerName" disabled /></div>
            <div><label>Product</label><input value="@_sourceKachi.ProductName" disabled /></div>
            <div><label>Net Weight (kg)</label><input value="@_sourceKachi.NetWeightKg.ToString("N2")" disabled /></div>
            <div>
                <label>Buyer</label>
                <select @bind="_buyerId">
                    @if (_buyers is not null) { @foreach (var b in _buyers) { <option value="@b.Id">@b.Name</option> } }
                </select>
            </div>
            <div><label>Rate per kg</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                @if (_rate is null or <= 0)
                {
                    <div class="invalid-total">Enter a rate greater than zero before finalizing.</div>
                }
                <button class="btn" disabled="@(_rate is null or <= 0)" @onclick="ConvertAsync">Finalize Pakki</button>
            </div>
        </div>
    }
    else
    {
        <div class="form-grid" style="margin-bottom:20px;">
            <div><label>Date</label><input type="date" @bind="_date" /></div>
            <div>
                <label>Season</label>
                <select @bind="_seasonId">
                    @if (_seasons is not null) { @foreach (var s in _seasons) { <option value="@s.Id">@s.Name</option> } }
                </select>
            </div>
            <div>
                <label>Farmer</label>
                <select @bind="_farmerId">
                    @if (_farmers is not null) { @foreach (var f in _farmers) { <option value="@f.Id">@f.Name</option> } }
                </select>
            </div>
            <div>
                <label>Buyer</label>
                <select @bind="_buyerId">
                    @if (_buyers is not null) { @foreach (var b in _buyers) { <option value="@b.Id">@b.Name</option> } }
                </select>
            </div>
            <div>
                <label>Product</label>
                <select @bind="_productId">
                    @if (_products is not null) { @foreach (var p in _products) { <option value="@p.Id">@p.Name</option> } }
                </select>
            </div>
            <div><label>Man</label><input type="number" step="0.01" @bind="_man" /></div>
            <div><label>Kilo</label><input type="number" step="0.01" @bind="_kilo" /></div>
            <div><label>Gram</label><input type="number" step="1" @bind="_gram" /></div>
            <div><label>Bori</label><input type="number" step="0.01" @bind="_bori" /></div>
            <div><label>Rate per kg</label><input type="number" step="0.01" @bind="_rate" /></div>
            <div><label>Vehicle Number</label><input @bind="_vehicleNumber" /></div>
            <div style="grid-column: span 2;">
                <button class="btn" disabled="@(!CanCreateStandalone)" @onclick="CreateStandaloneAsync">Save Standalone Pakki</button>
            </div>
        </div>
    }

    @if (_pakkis is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="data-grid">
            <thead><tr><th>Invoice</th><th>Date</th><th>Buyer</th><th>Farmer</th><th>Product</th><th>Gross</th><th>Deductions</th><th>Net to Farmer</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in _pakkis)
                {
                    <tr>
                        <td>@p.InvoiceNo</td>
                        <td>@p.Date.ToString("yyyy-MM-dd")</td>
                        <td>@p.BuyerName</td>
                        <td>@p.FarmerName</td>
                        <td>@p.ProductName</td>
                        <td>@p.GrossAmount.ToString("N2")</td>
                        <td>@p.TotalDeductions.ToString("N2")</td>
                        <td>@p.NetPayableToFarmer.ToString("N2")</td>
                        <td>@p.Status</td>
                        <td><a href="print/pakki/@p.Id">Print</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    [SupplyParameterFromQuery(Name = "fromKachi")]
    public int? FromKachi { get; set; }

    private KachiDto? _sourceKachi;
    private List<PakkiDto>? _pakkis;
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private string? _error;

    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _farmerId;
    private int _buyerId;
    private int _productId;
    private decimal? _man, _kilo, _gram, _bori;
    private decimal? _rate;
    private string? _vehicleNumber;

    private bool CanCreateStandalone => (_man ?? 0) + (_kilo ?? 0) + (_gram ?? 0) + (_bori ?? 0) > 0 && (_rate ?? 0) > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Buyer);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_farmers.Count > 0) _farmerId = _farmers[0].Id;
            if (_buyers.Count > 0) _buyerId = _buyers[0].Id;
            if (_products.Count > 0) _productId = _products[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; return; }

        if (FromKachi.HasValue)
        {
            try { _sourceKachi = await Api.GetKachiAsync(FromKachi.Value); }
            catch (Models.ApiException ex) { _error = ex.Message; }
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _pakkis = await Api.GetPakkisAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task ConvertAsync()
    {
        _error = null;
        try
        {
            await Api.CreatePakkiFromKachiAsync(new CreatePakkiFromKachiRequest(FromKachi!.Value, _date, _buyerId, _rate!.Value, _vehicleNumber, null));
            Nav.NavigateTo("/pakki");
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task CreateStandaloneAsync()
    {
        _error = null;
        try
        {
            await Api.CreateStandalonePakkiAsync(new CreateStandalonePakkiRequest(_date, _seasonId, _buyerId, _farmerId, _productId, _man, _kilo, _gram, _bori, _rate!.Value, _vehicleNumber, null));
            _man = null; _kilo = null; _gram = null; _bori = null; _rate = null; _vehicleNumber = null;
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
