@page "/reports/account-balance"
@inject ApiClient Api
@inject IJSRuntime JS

<RequireAuth>
    <div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <h1 class="page-title">Account Balance Report</h1>
        <button class="btn no-print" @onclick="PrintAsync">Print</button>
    </div>
    <CompanyHeader />

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    @if (_accountTypes is null || _balances is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="no-print" style="display:flex; align-items:flex-end; gap:16px; flex-wrap:wrap; margin-bottom:20px;">
            <div>
                <label style="display:block; font-size:0.85rem; color:#555;">From</label>
                <input type="date" @bind="_from" @bind:after="LoadBalancesAsync" style="width:160px;" />
            </div>
            <div>
                <label style="display:block; font-size:0.85rem; color:#555;">To</label>
                <input type="date" @bind="_to" @bind:after="LoadBalancesAsync" style="width:160px;" />
            </div>
            <div>
                <label style="display:block; font-size:0.85rem; color:#555;">Account Type</label>
                <select @bind="_selectedAccountType" style="width:200px;">
                    <option value="">— Select —</option>
                    @foreach (var t in _accountTypes)
                    {
                        <option value="@t.Name">@t.Name</option>
                    }
                </select>
            </div>

            @if (_selectedAccountType == PartyAccountTypeName)
            {
                <div>
                    <label style="display:block; font-size:0.85rem; color:#555;">Party Type</label>
                    <select @bind="_selectedPartyType" style="width:160px;">
                        <option value="">All</option>
                        @foreach (var pt in Enum.GetValues<PartyType>())
                        {
                            <option value="@pt">@pt</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label style="display:block; font-size:0.85rem; color:#555;">Amount Type</label>
                <select @bind="_amountType" style="width:140px;">
                    <option value="Both">Both</option>
                    <option value="Debit">Debit</option>
                    <option value="Credit">Credit</option>
                </select>
            </div>
        </div>

        @if (string.IsNullOrEmpty(_selectedAccountType))
        {
            <p style="color:#999;">Select an Account Type above to see balances.</p>
        }
        else if (_selectedAccountType == PartyAccountTypeName)
        {
            <table class="data-grid" style="max-width:1000px;">
                <thead><tr><th>Party</th><th>Type</th><th style="text-align:right;">Opening</th><th style="text-align:right;">Closing</th><th>Position</th></tr></thead>
                <tbody>
                    @foreach (var p in FilteredParties)
                    {
                        <tr>
                            <td>@p.Name @(string.IsNullOrEmpty(p.NameUrdu) ? "" : $"— {p.NameUrdu}")</td>
                            <td>@p.PartyType</td>
                            <td style="text-align:right;">@Math.Abs(p.OpeningBalance).ToString("N2")</td>
                            <td style="text-align:right;">@Math.Abs(p.ClosingBalance).ToString("N2")</td>
                            <td>
                                @if (p.ClosingBalance > 0)
                                {
                                    <span style="color:#1a7a3c;">Debit (Receivable)</span>
                                }
                                else if (p.ClosingBalance < 0)
                                {
                                    <span style="color:#b3261e;">Credit (Payable)</span>
                                }
                                else
                                {
                                    <span style="color:#999;">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredParties.Any())
                    {
                        <tr><td colspan="5" style="text-align:center;color:#999;">No parties found.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:600;">
                        <td>Total</td>
                        <td></td>
                        <td style="text-align:right;">@FilteredParties.Sum(p => Math.Abs(p.OpeningBalance)).ToString("N2")</td>
                        <td style="text-align:right;">@FilteredParties.Sum(p => Math.Abs(p.ClosingBalance)).ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <table class="data-grid" style="max-width:1000px;">
                <thead><tr><th>Code</th><th>Account</th><th style="text-align:right;">Opening</th><th style="text-align:right;">Closing</th><th>Position</th></tr></thead>
                <tbody>
                    @foreach (var a in FilteredAccounts)
                    {
                        <tr>
                            <td>@a.Code</td>
                            <td>@a.Name @(string.IsNullOrEmpty(a.NameUrdu) ? "" : $"— {a.NameUrdu}")</td>
                            <td style="text-align:right;">@Math.Abs(a.OpeningBalance).ToString("N2")</td>
                            <td style="text-align:right;">@Math.Abs(a.ClosingBalance).ToString("N2")</td>
                            <td>
                                @if (a.ClosingBalance > 0)
                                {
                                    <span style="color:#1a7a3c;">Debit</span>
                                }
                                else if (a.ClosingBalance < 0)
                                {
                                    <span style="color:#b3261e;">Credit</span>
                                }
                                else
                                {
                                    <span style="color:#999;">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredAccounts.Any())
                    {
                        <tr><td colspan="5" style="text-align:center;color:#999;">No accounts found.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:600;">
                        <td>Total</td>
                        <td></td>
                        <td style="text-align:right;">@FilteredAccounts.Sum(a => Math.Abs(a.OpeningBalance)).ToString("N2")</td>
                        <td style="text-align:right;">@FilteredAccounts.Sum(a => Math.Abs(a.ClosingBalance)).ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        }
    }
</RequireAuth>

@code {
    // "Party" sits in the same Account Type list as Asset/Cash/Bank/… (added from the legacy
    // software's own Account Type list — see Setup > Account Types) even though it's not a real
    // ChartOfAccount row; picking it here switches the report to party balances instead.
    private const string PartyAccountTypeName = "Party";

    private List<AccountTypeDto>? _accountTypes;
    private PeriodBalancesDto? _balances;
    private string? _error;

    private DateTime? _from;
    private DateTime? _to;
    private string _selectedAccountType = "";
    private string _selectedPartyType = "";
    private string _amountType = "Both";

    protected override async Task OnInitializedAsync()
    {
        try { _accountTypes = await Api.GetAccountTypesAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
        await LoadBalancesAsync();
    }

    // Opening = balance strictly before From (0 if From is blank — nothing is "before" an
    // unbounded start). Closing = balance on or before To (the live/current balance if To is
    // blank). Leaving both blank reproduces the report's old always-current behavior.
    private async Task LoadBalancesAsync()
    {
        _error = null;
        try { _balances = await Api.GetPeriodBalancesAsync(_from, _to); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private bool MatchesAmountType(decimal balance) => _amountType switch
    {
        "Debit" => balance > 0,
        "Credit" => balance < 0,
        _ => true
    };

    // PartyType is [Flags] — a party can carry more than one (e.g. Farmer|Vendor), so this checks
    // the selected flag is SET rather than comparing the whole value/ToString() for an exact match,
    // same as PartyService.GetAllAsync's own server-side filter.
    private bool MatchesPartyType(PartyBalanceDto p) => string.IsNullOrEmpty(_selectedPartyType)
        || (Enum.TryParse<PartyType>(_selectedPartyType, out var want) && (p.PartyType & want) == want);

    private List<PartyBalanceDto> FilteredParties => (_balances?.Parties ?? new())
        .Where(MatchesPartyType)
        .Where(p => MatchesAmountType(p.ClosingBalance))
        .OrderByDescending(p => p.ClosingBalance)
        .ToList();

    private List<AccountBalanceDto> FilteredAccounts => (_balances?.Accounts ?? new())
        .Where(a => a.AccountTypeName == _selectedAccountType)
        .Where(a => MatchesAmountType(a.ClosingBalance))
        .OrderBy(a => a.Code)
        .ToList();

    private Task PrintAsync() => JS.InvokeVoidAsync("print").AsTask();
}
