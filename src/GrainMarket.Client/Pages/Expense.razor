@page "/expense"
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Expense</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_successMessage is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
    }

    <div class="form-grid">
        <div><label>Date</label><input type="date" @bind="_date" /></div>
        <div>
            <label>Expense Account</label>
            <SearchSelect TItem="ChartOfAccountDto" Items="@(_accounts?.Where(a => a.AccountType == AccountType.Expense))" IdSelector="@(a => a.Id)" TextSelector="@DisplayText.Account" @bind-Value="_expenseAccountId" Placeholder="Search expense account…" />
        </div>
        <div><label>Amount</label><input type="number" step="0.01" @bind="_amount" /></div>
        <div>
            <label>Paid From</label>
            <select @bind="_paidFrom">
                <option value="@LedgerPartyRefType.Cash">Cash</option>
                <option value="@LedgerPartyRefType.Bank">Bank</option>
                <option value="@LedgerPartyRefType.Account">Other Account</option>
            </select>
        </div>
        @if (_paidFrom == LedgerPartyRefType.Account)
        {
            <div>
                <label>Account</label>
                <SearchSelect TItem="ChartOfAccountDto" Items="_accounts" IdSelector="@(a => a.Id)" TextSelector="@DisplayText.Account" Value="@(_paidFromAccountId ?? 0)" ValueChanged="@(v => _paidFromAccountId = v)" Placeholder="Search account…" />
            </div>
        }
        <div style="grid-column: span 2;"><label>Description</label><input @bind="_description" style="width:100%;" /></div>
        <div style="grid-column: span 2;">
            <button class="btn" disabled="@(_amount <= 0)" @onclick="SaveAsync">Save Expense</button>
        </div>
    </div>
</RequireAuth>

@code {
    private List<ChartOfAccountDto>? _accounts;
    private string? _error;
    private string? _successMessage;

    private DateTime _date = DateTime.Today;
    private int _expenseAccountId;
    private decimal _amount;
    private LedgerPartyRefType _paidFrom = LedgerPartyRefType.Cash;
    private int? _paidFromAccountId;
    private string? _description;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _accounts = await Api.GetChartOfAccountsAsync();
            var firstExpense = _accounts.FirstOrDefault(a => a.AccountType == AccountType.Expense);
            if (firstExpense is not null) _expenseAccountId = firstExpense.Id;
            if (_accounts.Count > 0) _paidFromAccountId = _accounts[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _successMessage = null;
        var request = new CreateExpenseRequest(_date, _expenseAccountId, _amount, _description, _paidFrom, _paidFrom == LedgerPartyRefType.Account ? _paidFromAccountId : null);
        try
        {
            var result = await Api.CreateExpenseAsync(request);
            _successMessage = $"Expense {result.ExpenseNo} saved.";
            _amount = 0; _description = null;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
