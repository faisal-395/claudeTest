@page "/"
@using GrainMarket.Application.Common
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Dashboard</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    else if (_summary is null)
    {
        <p>Loading…</p>
    }
    else
    {
        @if (_summary.ExpiringLots.Count > 0)
        {
            <div class="error-banner" style="max-width:1100px;margin-bottom:16px;">
                <strong>Expiring stock:</strong> @_summary.ExpiringLots.Count lot(s) expiring within @DomainConstants.ExpiryAlertWindowDays days or already past expiry.
                <table class="data-grid" style="margin-top:8px;">
                    <thead><tr><th>Product</th><th>Remaining</th><th>Expiry Date</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var lot in _summary.ExpiringLots)
                        {
                            <tr>
                                <td>@lot.ProductName @(lot.NameUrdu is { Length: > 0 } u ? $"/ {u}" : "")</td>
                                <td>@lot.RemainingQuantity.ToString("N2") @lot.BaseUnit</td>
                                <td>@lot.ExpiryDate.ToString("yyyy-MM-dd")</td>
                                <td>@(lot.DaysUntilExpiry < 0 ? $"Expired {-lot.DaysUntilExpiry}d ago" : lot.DaysUntilExpiry == 0 ? "Expires today" : $"{lot.DaysUntilExpiry}d left")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1100px;">
            <StatCard Title="Kachi Today" Value="@_summary.TodayKachiCount.ToString()" Sub="@($"{_summary.TodayKachiWeightKg:N0} kg")" />
            <StatCard Title="Pakki Today" Value="@_summary.TodayPakkiCount.ToString()" Sub="@($"Rs {_summary.TodayPakkiGrossAmount:N0}")" />
            <StatCard Title="Sale Invoices Today" Value="@_summary.TodaySaleInvoiceCount.ToString()" Sub="@($"Rs {_summary.TodaySaleNetBill:N0}")" />
            <StatCard Title="Purchases Today" Value="@_summary.TodayPurchaseCount.ToString()" Sub="@($"Rs {_summary.TodayPurchaseNetBill:N0}")" />
            <StatCard Title="Cash Balance" Value="@($"Rs {_summary.CashBalance:N0}")" />
            <StatCard Title="Bank Balance" Value="@($"Rs {_summary.BankBalance:N0}")" />
            <StatCard Title="Outstanding Recovery" Value="@($"Rs {_summary.TotalOutstandingRecovery:N0}")" />
        </div>
    }
</RequireAuth>

@code {
    private DashboardSummaryDto? _summary;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Api.GetDashboardAsync();
        }
        catch (Models.ApiException ex)
        {
            _error = ex.Message;
        }
    }
}
