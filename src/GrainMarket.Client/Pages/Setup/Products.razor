@page "/setup/products"
@using GrainMarket.Application.Common
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Products</h1>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    <div class="form-grid" style="margin-bottom:20px;">
        <div>
            <label>Name (English)</label>
            <input @bind="_name" />
        </div>
        <div>
            <label>Name (Urdu)</label>
            <input class="rtl-urdu" @bind="_nameUrdu" />
        </div>
        <div>
            <label>Category</label>
            <select value="@_category" @onchange="OnCategoryChanged">
                <option value="@DomainConstants.ProductCategoryGrain">Grain (Kachi/Pakki)</option>
                <option value="@DomainConstants.ProductCategoryInput">Input (Purchase/Sale)</option>
            </select>
        </div>
        <div>
            <label>Unit</label>
            <input @bind="_baseUnit" list="unit-suggestions" maxlength="10" placeholder="kg" />
            <datalist id="unit-suggestions">
                <option value="kg" /><option value="Litre" /><option value="Bag" /><option value="Pack" /><option value="Pcs" />
            </datalist>
        </div>
        <div>
            <label>Default Rate</label>
            <input type="number" step="0.01" @bind="_defaultRate" />
        </div>
        <div>
            <label>Sale Price (fixed)</label>
            <input type="number" step="0.01" @bind="_salePrice" placeholder="Leave blank to use markup %" />
        </div>
        <div>
            <label>Sale Markup % (over purchase cost)</label>
            <input type="number" step="0.01" @bind="_saleMarkupPercent" placeholder="Used when Sale Price is blank" />
        </div>
        <div style="grid-column: span 2;">
            <button class="btn" @onclick="SaveAsync">@(_editingId is null ? "Add Product" : "Update Product")</button>
            @if (_editingId is not null)
            {
                <button class="btn secondary" @onclick="ResetForm">Cancel</button>
            }
        </div>
    </div>

    @if (_products is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr><th>Name</th><th>Urdu</th><th>Category</th><th>Unit</th><th>Rate</th><th>Sale Price</th><th>Markup %</th><th>Active</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in _products)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td class="rtl-urdu">@p.NameUrdu</td>
                        <td>@p.Category</td>
                        <td>@p.BaseUnit</td>
                        <td>@p.DefaultRate.ToString("N2")</td>
                        <td>@(p.SalePrice is { } sp ? sp.ToString("N2") : "—")</td>
                        <td>@(p.SaleMarkupPercent is { } mp ? $"{mp:N2}%" : "—")</td>
                        <td>@(p.IsActive ? "Yes" : "No")</td>
                        <td>
                            <button class="btn secondary" @onclick="() => Edit(p)">Edit</button>
                            <button class="btn danger" @onclick="() => DeleteAsync(p.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    private List<ProductDto>? _products;
    private int? _editingId;
    private string? _error;

    private string _name = "";
    private string? _nameUrdu;
    private string _category = DomainConstants.ProductCategoryGrain;
    private string _baseUnit = "kg";
    private decimal _defaultRate;
    private decimal? _salePrice;
    private decimal? _saleMarkupPercent;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try { _products = await Api.GetProductsAsync(includeInactive: true); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        _category = e.Value?.ToString() ?? DomainConstants.ProductCategoryGrain;
        // Grain always weighs in kg for Kachi/Pakki — reset the unit so it doesn't silently carry
        // over an Input unit (Litre, Bag, …) left over from a previous edit. Still editable after.
        if (_category == DomainConstants.ProductCategoryGrain) _baseUnit = "kg";
    }

    private void Edit(ProductDto p)
    {
        _editingId = p.Id;
        _name = p.Name; _nameUrdu = p.NameUrdu; _category = p.Category ?? DomainConstants.ProductCategoryGrain;
        _baseUnit = p.BaseUnit; _defaultRate = p.DefaultRate;
        _salePrice = p.SalePrice; _saleMarkupPercent = p.SaleMarkupPercent;
    }

    private void ResetForm()
    {
        _editingId = null;
        _name = ""; _nameUrdu = null; _category = DomainConstants.ProductCategoryGrain;
        _baseUnit = "kg"; _defaultRate = 0; _salePrice = null; _saleMarkupPercent = null;
    }

    private async Task SaveAsync()
    {
        _error = null;
        var request = new UpsertProductRequest(_name, _nameUrdu, _category, _baseUnit, _defaultRate, true, _salePrice, _saleMarkupPercent);
        try
        {
            if (_editingId is null) await Api.CreateProductAsync(request);
            else await Api.UpdateProductAsync(_editingId.Value, request);
            ResetForm();
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task DeleteAsync(int id)
    {
        try { await Api.DeleteProductAsync(id); await LoadAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
