@page "/setup/unit-conversions"
@using GrainMarket.Application.Common
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Unit Conversions</h1>
    <p style="color:#777;">Local weight units (Man/maund, Kilo, Gram, Bori/bag) convert to the base unit (kg) using these factors. A product-specific row overrides the global default for that product only.</p>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }

    <div class="form-grid" style="margin-bottom:20px;">
        <div>
            <label>Unit</label>
            <select @bind="_unit">
                @foreach (var u in Enum.GetValues<WeightUnit>())
                {
                    <option value="@u">@u</option>
                }
            </select>
        </div>
        <div><label>Factor to Kg</label><input type="number" step="0.0001" @bind="_factor" /></div>
        <div>
            <label>Product (optional — blank = global default)</label>
            <select @bind="_productId">
                <option value="">(Global default)</option>
                @if (_products is not null)
                {
                    @foreach (var p in _products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                }
            </select>
        </div>
        <div style="grid-column: span 2;">
            <button class="btn" @onclick="SaveAsync">@(_editingId is null ? "Add" : "Update")</button>
            @if (_editingId is not null) { <button class="btn secondary" @onclick="ResetForm">Cancel</button> }
        </div>
    </div>

    @if (_conversions is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <table class="data-grid">
            <thead><tr><th>Unit</th><th>Factor (kg)</th><th>Product</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in _conversions)
                {
                    <tr>
                        <td>@c.Unit</td>
                        <td>@c.FactorToKg.ToString("N4")</td>
                        <td>@(c.ProductName ?? "(Global default)")</td>
                        <td>
                            <button class="btn secondary" @onclick="() => Edit(c)">Edit</button>
                            <button class="btn danger" @onclick="() => DeleteAsync(c.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</RequireAuth>

@code {
    private List<UnitConversionDto>? _conversions;
    private List<ProductDto>? _products;
    private int? _editingId;
    private string? _error;

    private WeightUnit _unit = WeightUnit.Man;
    private decimal _factor;
    private string _productId = "";

    protected override async Task OnInitializedAsync()
    {
        try { _products = await Api.GetProductsAsync(category: DomainConstants.ProductCategoryGrain); }
        catch (Models.ApiException ex) { _error = ex.Message; return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try { _conversions = await Api.GetUnitConversionsAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void Edit(UnitConversionDto c)
    {
        _editingId = c.Id;
        _unit = c.Unit; _factor = c.FactorToKg; _productId = c.ProductId?.ToString() ?? "";
    }

    private void ResetForm()
    {
        _editingId = null; _unit = WeightUnit.Man; _factor = 0; _productId = "";
    }

    private async Task SaveAsync()
    {
        _error = null;
        int? productId = string.IsNullOrEmpty(_productId) ? null : int.Parse(_productId);
        var request = new UpsertUnitConversionRequest(_unit, _factor, productId, true);
        try
        {
            if (_editingId is null) await Api.CreateUnitConversionAsync(request);
            else await Api.UpdateUnitConversionAsync(_editingId.Value, request);
            ResetForm();
            await LoadAsync();
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task DeleteAsync(int id)
    {
        try { await Api.DeleteUnitConversionAsync(id); await LoadAsync(); }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
