@page "/purchase"
@using GrainMarket.Application.Common
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Purchase</h1>
    <p style="color:#777;">Buy pesticides, seeds, fertilizer and other farm inputs from a supplier.</p>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_successMessage is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:8px 12px;margin-bottom:12px;">@_successMessage</div>
    }

    <div class="form-grid" style="max-width:1100px;">
        <div><label>Bill No</label><input @bind="_billNo" /></div>
        <div><label>Date</label><input type="date" @bind="_date" /></div>
        <div>
            <label>Supplier</label>
            <SearchSelect TItem="PartyDto" Items="_suppliers" IdSelector="@(s => s.Id)" TextSelector="@DisplayText.Party" @bind-Value="_supplierId" Placeholder="Search supplier…" />
        </div>
        <div><label>Balance</label><div class="total-figure" style="padding-top:6px;">Rs @SelectedSupplierBalance.ToString("N2")</div></div>
    </div>

    <h3 style="margin-top:20px;">Add Product</h3>
    <div class="form-grid" style="max-width:1100px;">
        <div>
            <label>Product</label>
            <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_stagingProductId" Placeholder="Search product…" />
        </div>
        <div><label>Quantity</label><input type="number" step="0.01" @bind="_stagingQuantity" /></div>
        <div><label>Price</label><input type="number" step="0.01" @bind="_stagingPrice" /></div>
        <div><label>Discount %</label><input type="number" step="0.01" @bind="_stagingDiscountPercent" /></div>
        <div><label>Expiry Date</label><input type="date" @bind="_stagingExpiryDate" title="Optional — only for products with a shelf life" /></div>
        <div><label>Net</label><div class="total-figure" style="padding-top:6px;">Rs @StagingNet.ToString("N2")</div></div>
        <div style="grid-column: span 2;">
            <button class="btn secondary" disabled="@(!CanAddStagedLine)" @onclick="AddStagedLine">+ Add to Purchase</button>
        </div>
    </div>

    <table class="data-grid" style="max-width:1100px;margin-top:14px;">
        <thead><tr><th>Product</th><th>Qty</th><th>Price</th><th>Discount %</th><th>Net</th><th>Expiry Date</th><th></th></tr></thead>
        <tbody>
            @for (var i = 0; i < _lines.Count; i++)
            {
                var index = i;
                var line = _lines[index];
                <tr>
                    <td>@ProductName(line.ProductId)</td>
                    <td>@line.Quantity.ToString("N2")</td>
                    <td>@line.Price.ToString("N2")</td>
                    <td>@line.DiscountPercent.ToString("N2")</td>
                    <td>@LineNet(line).ToString("N2")</td>
                    <td>@(line.ExpiryDate is { } ed ? ed.ToString("yyyy-MM-dd") : "—")</td>
                    <td><button class="btn danger" @onclick="() => _lines.RemoveAt(index)">Remove</button></td>
                </tr>
            }
            @if (_lines.Count == 0)
            {
                <tr><td colspan="7" style="text-align:center;color:#999;">No lines added yet.</td></tr>
            }
        </tbody>
    </table>

    <div class="form-grid" style="max-width:1100px;margin-top:14px;">
        <div class="total-figure">Total Bill: Rs @TotalBill.ToString("N2")</div>
        <div><label>Paid Cash</label><input type="number" step="0.01" @bind="_paidCash" /></div>
        <div style="grid-column: span 2;">
            @if (_lines.Count == 0)
            {
                <div class="invalid-total">Add at least one line item.</div>
            }
            <button class="btn" disabled="@(_lines.Count == 0)" @onclick="SaveAsync">Save Purchase</button>
        </div>
    </div>
</RequireAuth>

@code {
    private List<PartyDto>? _suppliers;
    private List<ProductDto>? _products;
    private string? _error;
    private string? _successMessage;

    private string? _billNo;
    private DateTime _date = DateTime.Today;
    private int _supplierId;
    private decimal _paidCash;
    private readonly List<LineModel> _lines = new();

    private int _stagingProductId;
    private decimal _stagingQuantity = 1;
    private decimal _stagingPrice;
    private decimal _stagingDiscountPercent;
    private DateTime? _stagingExpiryDate;

    private decimal TotalBill => _lines.Sum(LineNet);

    private decimal SelectedSupplierBalance => _suppliers?.FirstOrDefault(s => s.Id == _supplierId)?.CurrentBalance ?? 0;

    private bool CanAddStagedLine => _stagingProductId > 0 && _stagingQuantity > 0;

    private decimal StagingNet => LineNet(_stagingQuantity, _stagingPrice, _stagingDiscountPercent);

    private string ProductName(int productId) => _products?.FirstOrDefault(p => p.Id == productId) is { } p ? DisplayText.Product(p) : "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _suppliers = await Api.GetPartiesAsync(PartyType.Supplier);
            _products = await Api.GetProductsAsync(category: DomainConstants.ProductCategoryInput);
            if (_suppliers.Count > 0) _supplierId = _suppliers[0].Id;
            if (_products.Count > 0) _stagingProductId = _products[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private void AddStagedLine()
    {
        _lines.Add(new LineModel { ProductId = _stagingProductId, Quantity = _stagingQuantity, Price = _stagingPrice, DiscountPercent = _stagingDiscountPercent, ExpiryDate = _stagingExpiryDate });

        _stagingProductId = _products?.FirstOrDefault()?.Id ?? 0;
        _stagingQuantity = 1;
        _stagingPrice = 0;
        _stagingDiscountPercent = 0;
        _stagingExpiryDate = null;
    }

    private static decimal LineNet(LineModel l) => LineNet(l.Quantity, l.Price, l.DiscountPercent);

    private static decimal LineNet(decimal quantity, decimal price, decimal discountPercent)
    {
        var gross = quantity * price;
        return gross - gross * (discountPercent / 100m);
    }

    private async Task SaveAsync()
    {
        _error = null;
        _successMessage = null;
        var request = new CreatePurchaseRequest(
            _date, _billNo, _supplierId,
            _lines.Select(l => new PurchaseLineRequest(l.ProductId, l.Quantity, l.Price, l.DiscountPercent, l.ExpiryDate)).ToList(),
            _paidCash, PrintFormat.A4, PrintLanguage.English);
        try
        {
            var result = await Api.CreatePurchaseAsync(request);
            _successMessage = $"Purchase {result.InvoiceNo} saved. See it under Records Report.";
            _lines.Clear();
            _paidCash = 0;
            _billNo = null;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private class LineModel
    {
        public int ProductId { get; set; }
        public decimal Quantity { get; set; }
        public decimal Price { get; set; }
        public decimal DiscountPercent { get; set; }
        public DateTime? ExpiryDate { get; set; }
    }
}
