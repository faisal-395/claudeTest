@page "/dual-invoice"
@inject ApiClient Api

<RequireAuth>
    <h1 class="page-title">Dual Invoice (Kachi + Pakki in one step) <span class="rtl-urdu" style="font-size:1rem;">کچی و پکی</span></h1>
    <p style="color:#777;">For when the farmer, buyer and rate are all known up front — raises a Kachi and immediately finalizes it as a Pakki. Use the separate Kachi screen when the rate isn't settled yet.</p>

    @if (_error is not null)
    {
        <div class="error-banner">@_error</div>
    }
    @if (_result is not null)
    {
        <div style="background:#eaf7ee;border:1px solid #b6e3c2;padding:12px 16px;margin-bottom:16px;">
            Created Kachi <b>@_result.KachiInvoiceNo</b> and Pakki <b>@_result.PakkiInvoiceNo</b> — net payable to farmer: Rs @_result.NetPayableToFarmer.ToString("N2")
        </div>
    }

    <div class="form-grid">
        <div><label>Date</label><input type="date" @bind="_date" /></div>
        <div>
            <label>Season</label>
            <select @bind="_seasonId">
                @if (_seasons is not null) { @foreach (var s in _seasons) { <option value="@s.Id">@s.Name</option> } }
            </select>
        </div>
        <div>
            <label>Farmer / کسان</label>
            <SearchSelect TItem="PartyDto" Items="_farmers" IdSelector="@(f => f.Id)" TextSelector="@DisplayText.Party" @bind-Value="_farmerId" Placeholder="Search farmer…" />
        </div>
        <div>
            <label>Buyer / خریدار</label>
            <SearchSelect TItem="PartyDto" Items="_buyers" IdSelector="@(b => b.Id)" TextSelector="@DisplayText.Party" @bind-Value="_buyerId" Placeholder="Search buyer…" />
        </div>
        <div>
            <label>Product / جنس</label>
            <SearchSelect TItem="ProductDto" Items="_products" IdSelector="@(p => p.Id)" TextSelector="@DisplayText.Product" @bind-Value="_productId" Placeholder="Search product…" />
        </div>
        <div><label>Man / مَن</label><input type="number" step="0.01" @bind="_man" /></div>
        <div><label>Kilo / کلو</label><input type="number" step="0.01" @bind="_kilo" /></div>
        <div><label>Gram / گرام</label><input type="number" step="1" @bind="_gram" /></div>
        <div><label>Bori / بوری</label><input type="number" step="0.01" @bind="_bori" /></div>
        <div><label>Rate per Man / ریٹ فی مَن</label><input type="number" step="0.01" @bind="_rate" /></div>
        <div><label>Vehicle Number / گاڑی نمبر</label><input @bind="_vehicleNumber" /></div>
        <div style="grid-column: span 2;">
            @if (!CanSave)
            {
                <div class="invalid-total">Enter weight and a rate greater than zero.</div>
            }
            <button class="btn" disabled="@(!CanSave)" @onclick="SaveAsync">Create Dual Invoice</button>
        </div>
    </div>
</RequireAuth>

@code {
    private List<SeasonDto>? _seasons;
    private List<PartyDto>? _farmers;
    private List<PartyDto>? _buyers;
    private List<ProductDto>? _products;
    private DualInvoiceResultDto? _result;
    private string? _error;

    private DateTime _date = DateTime.Today;
    private int _seasonId;
    private int _farmerId;
    private int _buyerId;
    private int _productId;
    private decimal? _man, _kilo, _gram, _bori;
    private decimal _rate;
    private string? _vehicleNumber;

    private bool CanSave => (_man ?? 0) + (_kilo ?? 0) + (_gram ?? 0) + (_bori ?? 0) > 0 && _rate > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _seasons = await Api.GetSeasonsAsync();
            _farmers = await Api.GetPartiesAsync(PartyType.Farmer);
            _buyers = await Api.GetPartiesAsync(PartyType.Buyer);
            _products = await Api.GetProductsAsync();
            if (_seasons.Count > 0) _seasonId = _seasons[0].Id;
            if (_farmers.Count > 0) _farmerId = _farmers[0].Id;
            if (_buyers.Count > 0) _buyerId = _buyers[0].Id;
            if (_products.Count > 0) _productId = _products[0].Id;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _result = null;
        var request = new CreateDualInvoiceRequest(_date, _seasonId, _farmerId, _buyerId, _productId, _man, _kilo, _gram, _bori, _rate, _vehicleNumber, null);
        try
        {
            _result = await Api.CreateDualInvoiceAsync(request);
            _man = null; _kilo = null; _gram = null; _bori = null; _rate = 0; _vehicleNumber = null;
        }
        catch (Models.ApiException ex) { _error = ex.Message; }
    }
}
