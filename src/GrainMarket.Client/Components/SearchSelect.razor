@* Type-to-filter dropdown used in place of a native <select> for long lists (farmers, buyers,
   products, accounts…). Native <select> popups render as an OS-level overlay inside the
   Windows WebView2 host and can appear detached from the control (wrong position/size) after
   the window is resized, moved, or the display's DPI scaling kicks in — this renders entirely
   inside normal page flow instead, sidestepping that. *@
@typeparam TItem
@inject IJSRuntime JS

<div class="search-select" tabindex="-1" @onfocusout="HandleFocusOut">
    <input @ref="_inputRef" class="search-select-input" type="text" autocomplete="off"
           value="@_displayText"
           placeholder="@Placeholder"
           @oninput="OnInput"
           @onfocus="OnFocus"
           @onkeydown="OnKeyDown" />
    @if (_open && _filtered.Count > 0)
    {
        <div @ref="_menuRef" class="search-select-menu" @onmousedown:preventDefault="true"
             @onwheel="OnWheel" @onwheel:preventDefault="true">
            @for (var i = 0; i < _filtered.Count; i++)
            {
                var item = _filtered[i];
                var index = i;
                <div @key="IdSelector(item)" class="search-select-option @(index == _highlighted ? "highlighted" : "")"
                     @onmousedown:preventDefault="true"
                     @onmousedown="() => Select(item)">
                    @TextSelector(item)
                </div>
            }
        </div>
    }
    @if (_open && _filtered.Count == 0)
    {
        <div class="search-select-menu">
            <div class="search-select-option search-select-empty">No matches</div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }
    [Parameter, EditorRequired] public Func<TItem, int> IdSelector { get; set; } = default!;
    [Parameter, EditorRequired] public Func<TItem, string> TextSelector { get; set; } = default!;
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Type to search…";

    private List<TItem> _filtered = new();
    private string _query = string.Empty;
    private string _displayText = string.Empty;
    private bool _open;
    private int _highlighted;
    private int? _lastValue;
    private List<int>? _lastItemIds;
    private ElementReference _inputRef;
    private ElementReference _menuRef;

    // Lets a parent move keyboard focus here programmatically (e.g. VoucherForm focusing the
    // party picker as soon as the form opens).
    public async Task FocusAsync() => await _inputRef.FocusAsync();

    // This menu sits position:absolute inside .main-content, which is ALSO a scroll container —
    // that nesting is a known source of WebView2/Chromium wheel-routing glitches where a scroll
    // gesture intermittently gets delivered to the wrong one of the two scrollers, making the
    // wheel feel like it randomly stalls partway through. Taking the wheel event over entirely
    // (preventDefault + set scrollTop ourselves) sidesteps that native routing altogether, so the
    // menu always scrolls, deterministically, regardless of what's scrollable underneath it.
    private async Task OnWheel(WheelEventArgs e) => await JS.InvokeVoidAsync("searchSelectScroll", _menuRef, e.DeltaY);

    protected override void OnParametersSet()
    {
        var items = (Items ?? Enumerable.Empty<TItem>()).ToList();

        if (!_open && Value != _lastValue)
        {
            var selected = items.FirstOrDefault(i => IdSelector(i) == Value);
            _displayText = selected is not null ? TextSelector(selected) : string.Empty;
        }
        _lastValue = Value;

        // Callers often pass Items as a computed property (a fresh List instance every render),
        // so re-filtering on every single OnParametersSet — which fires on every parent render,
        // not just when the list actually changed — was rebuilding and re-rendering the open menu
        // on every unrelated keystroke/tick elsewhere on the page. That churn mid-gesture is what
        // made the mouse wheel feel "stuck" while scrolling an open dropdown. Skip it when the
        // underlying ids/order are unchanged.
        var itemIds = items.Select(IdSelector).ToList();
        if (_lastItemIds is null || !itemIds.SequenceEqual(_lastItemIds))
        {
            _lastItemIds = itemIds;
            Filter(items);
        }
    }

    private void Filter(List<TItem>? items = null)
    {
        var source = items ?? (Items ?? Enumerable.Empty<TItem>()).ToList();
        _filtered = string.IsNullOrWhiteSpace(_query)
            ? source
            : source.Where(i => TextSelector(i).Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();
        if (_highlighted >= _filtered.Count)
        {
            _highlighted = 0;
        }
    }

    private void OnFocus()
    {
        _open = true;
        _query = string.Empty;
        _displayText = string.Empty;
        Filter();
    }

    private void OnInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _displayText = _query;
        _open = true;
        _highlighted = 0;
        Filter();
    }

    private void HandleFocusOut()
    {
        _open = false;
        var items = (Items ?? Enumerable.Empty<TItem>()).ToList();
        var selected = items.FirstOrDefault(i => IdSelector(i) == Value);
        _displayText = selected is not null ? TextSelector(selected) : string.Empty;
    }

    private async Task Select(TItem item)
    {
        _open = false;
        var newValue = IdSelector(item);
        _displayText = TextSelector(item);
        _lastValue = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                if (_filtered.Count > 0) _highlighted = Math.Min(_highlighted + 1, _filtered.Count - 1);
                _open = true;
                break;
            case "ArrowUp":
                if (_filtered.Count > 0) _highlighted = Math.Max(_highlighted - 1, 0);
                _open = true;
                break;
            case "Enter":
                if (_open && _filtered.Count > 0)
                {
                    await Select(_filtered[_highlighted]);
                }
                break;
            case "Escape":
                _open = false;
                break;
        }
    }
}
